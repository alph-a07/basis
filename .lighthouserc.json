{
  "ci": {
    "collect": {
      "staticDistDir": "./docs/docs-site/dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/docs/components/button/index.html",
        "http://localhost/docs/components/button/api/index.html",
        "http://localhost/docs/components/button/overrides/index.html",
        "http://localhost/docs/components/button/accessibility/index.html"
      ]
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.90 }]
      }
    }
  }
}
