{
  "ci": {
    "collect": {
      "staticDistDir": "./docs/docs-site/dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/docs/getting-started/overview/index.html",
        "http://localhost/docs/theming/set-brand/index.html",
        "http://localhost/docs/foundation/surface/index.html",
        "http://localhost/docs/foundation/focusable/index.html",
        "http://localhost/studio/index.html"
      ]
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.90 }]
      }
    }
  }
}
