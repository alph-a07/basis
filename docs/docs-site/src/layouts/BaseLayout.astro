---
import '../styles/theme.css';
import '../styles/docs-tokens.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Basis — Jetpack Compose design system' } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Basis</title>

    <!-- Synchronous blocking theme script in head to prevent FOUC / theme flash -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('basis-theme');
          const theme = stored || 'dark';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (_) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
  }

  /* Custom theme-aligned global scrollbars */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--docs-scrollbar-thumb) transparent;
  }

  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  ::-webkit-scrollbar-track {
    background: var(--docs-scrollbar-track);
  }

  ::-webkit-scrollbar-thumb {
    background-color: var(--docs-scrollbar-thumb);
    border-radius: 9999px;
    border: 2px solid transparent;
    background-clip: padding-box;
    transition: background-color 0.15s ease;
  }

  ::-webkit-scrollbar-thumb:hover {
    background-color: var(--docs-scrollbar-thumb-hover);
  }

  ::-webkit-scrollbar-corner {
    background: transparent;
  }

  body {
    margin: 0;
    padding: 0;
    background-color: var(--docs-bg);
    color: var(--docs-text);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    min-height: 100vh;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  ::selection {
    background-color: var(--docs-selection-surface);
    color: var(--docs-selection-content);
  }

  :focus-visible {
    outline: 2px solid var(--docs-focus-ring);
    outline-offset: 2px;
  }

  /* Motion rules honoring prefers-reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
