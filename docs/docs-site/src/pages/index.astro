---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const components = await getCollection('components');
---

<BaseLayout title="Basis — Jetpack Compose Design System">
  <main data-pagefind-body>
    <header style="padding: 4rem 2rem; text-align: center; max-width: 800px; margin: 0 auto;">
      <h1 style="font-size: 3rem; margin-bottom: 1rem; font-weight: 800;">Basis Design System</h1>
      <p style="font-size: 1.25rem; color: #8b949e; line-height: 1.6;">
        A stable, simple, configurable design system for Jetpack Compose driven by intent.
      </p>
      <div style="margin-top: 2rem; display: flex; gap: 1rem; justify-content: center;">
        <a
          href="/docs/components/button"
          style="background: #238636; color: white; padding: 0.75rem 1.5rem; border-radius: 6px; text-decoration: none; font-weight: 600;"
        >
          Explore Components ({components.length})
        </a>
        <a
          href="/studio"
          style="background: #21262d; color: #c9d1d9; border: 1px solid #30363d; padding: 0.75rem 1.5rem; border-radius: 6px; text-decoration: none; font-weight: 600;"
        >
          Open Intent Studio
        </a>
      </div>
    </header>
  </main>
</BaseLayout>
