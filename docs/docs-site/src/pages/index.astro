---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadIntentDoc } from '../lib/load-intent';
import { deriveControlSpecs } from '../lib/control-generator';
import ChoiceChips from '../components/controls/ChoiceChips.astro';
import ColorField from '../components/controls/ColorField.astro';
import {
  ButtonSpecimen,
  CardSpecimen,
  InputSpecimen,
  ChipsSpecimen,
  SwitchSpecimen,
  ListItemSpecimen,
  IllustrativeNote,
} from '../components/specimens';
import { resolveLandingDefaultCss } from '../lib/resolve-landing-default';

const intentDoc = loadIntentDoc();
const controlSpecs = deriveControlSpecs(intentDoc);

// Build-time no-JS fallback resolution for default intent
const defaultLandingCss = resolveLandingDefaultCss();
---

<BaseLayout title="Basis — Jetpack Compose Design System">
  <!-- Inlined deterministic tokens for no-JS instant paint -->
  <style id="landing-preview-default" set:html={defaultLandingCss.css} />

  <div class="landing-page-wrap">
    <!-- Ambient Organic Animated Blobs (banding-free aurora backdrop reactive to intent controls) -->
    <div class="landing-ambient-stage" aria-hidden="true">
      <div class="ambient-blob blob-center"></div>
      <div class="ambient-blob blob-left"></div>
      <div class="ambient-blob blob-right"></div>
      <div class="ambient-blob blob-top"></div>
      <div class="ambient-blur-backdrop"></div>
    </div>

    <!-- Top Navigation Bar matching Mock -->
    <header class="landing-topbar" aria-label="Main Site Navigation">
    <div class="topbar-inner">
      <div class="topbar-left">
        <a href="/" class="brand-link" aria-label="Basis Home">
          <div class="brand-icon-box" aria-hidden="true">
            <svg class="brand-icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none">
              <rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="2.2" />
              <path d="M7 17L17 7M17 7H10M17 7V14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <span class="brand-wordmark">Basis</span>
        </a>
      </div>

      <nav class="topbar-nav" aria-label="Documentation Navigation">
        <a href="/docs/getting-started/overview" class="nav-item is-active">
          <span>Getting Started</span>
          <span class="active-indicator" aria-hidden="true"></span>
        </a>
        <a href="/docs/theming/color-science" class="nav-item">Theming</a>
        <a href="/docs/foundation/surface" class="nav-item">Components</a>
        <a href="/docs/foundation/surface" class="nav-item">Foundation</a>
        <a href="/studio" class="nav-item">Studio</a>
      </nav>

      <div class="topbar-right">
        <span class="version-badge" title="Basis Core Version">
          v0.1.0
        </span>

        <button
          type="button"
          id="global-theme-toggle"
          class="topbar-icon-btn"
          aria-label="Toggle dark/light theme"
        >
          <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="5" />
            <line x1="12" y1="1" x2="12" y2="3" />
            <line x1="12" y1="21" x2="12" y2="23" />
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
            <line x1="1" y1="12" x2="3" y2="12" />
            <line x1="21" y1="12" x2="23" y2="12" />
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
          </svg>
          <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </button>

        <a
          href="https://github.com/alph-a07/basis"
          target="_blank"
          rel="noopener noreferrer"
          class="topbar-icon-btn"
          aria-label="GitHub Repository"
        >
          <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
        </a>
      </div>
    </div>
  </header>

  <!-- Main Hero Stage with Isolated Basis Theme Preview Scope -->
  <main class="landing-main">
    <div id="landing-preview" class="basis-preview-scope" data-scope="preview">
      <!-- Cosmic Arena Canvas: Exactly Matching Mock Coordinates & Floating Angles -->
      <section class="cosmic-arena-canvas" aria-label="Basis Interactive Theme Visualizer">
        <!-- Floating 3D Diamond Confetti Shards -->
        <div class="confetti-shard shard-cyan" aria-hidden="true"></div>
        <div class="confetti-shard shard-purple" aria-hidden="true"></div>
        <div class="confetti-shard shard-orange" aria-hidden="true"></div>
        <div class="confetti-shard shard-coral" aria-hidden="true"></div>
        <div class="confetti-shard shard-violet" aria-hidden="true"></div>

        <!-- 1. LEFT FLANK SATELLITES (Organic Floating Tilted Cards) -->
        <!-- Satellite: Button (Top-left) -->
        <div class="sat-card sat-pos-button">
          <span class="sat-tag">Button</span>
          <div class="sat-body">
            <ButtonSpecimen variant="primary" class="sat-mock-btn">
              Button
            </ButtonSpecimen>
          </div>
        </div>

        <!-- Satellite: Card (Mid-left) -->
        <div class="sat-card sat-pos-card">
          <span class="sat-tag">Card</span>
          <div class="sat-body sat-avatar-row">
            <div class="sat-avatar-circle" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
              </svg>
            </div>
            <div class="sat-skeleton-bars" aria-hidden="true">
              <span class="skeleton-bar bar-long"></span>
              <span class="skeleton-bar bar-short"></span>
            </div>
          </div>
        </div>

        <!-- Satellite: Input (Lower-left) -->
        <div class="sat-card sat-pos-input">
          <span class="sat-tag">Input</span>
          <div class="sat-body sat-input-stack">
            <span class="sat-micro-label">Label</span>
            <InputSpecimen id="landing-sat-input" placeholder="Type here..." disabled={true} state="disabled" />
          </div>
        </div>

        <!-- 2. CENTRAL ORBITAL SYSTEM (2D Top-Plane Concentric Rings) -->
        <svg class="orbital-rings-svg" viewBox="-340 -340 680 680" aria-hidden="true">
          <!-- 1. Tight 2D circular ring right around the orb -->
          <circle cx="0" cy="0" r="70" class="orbit-path orbit-inner" />
          <!-- 2. Mid dashed 2D circular orbit ring -->
          <circle cx="0" cy="0" r="145" class="orbit-path orbit-mid" />
          <!-- 3. Major 2D circular orbit ring behind cards -->
          <circle cx="0" cy="0" r="225" class="orbit-path orbit-outer" />
          <!-- 4. Extended faint outer radar ring -->
          <circle cx="0" cy="0" r="305" class="orbit-path orbit-faint" />

          <!-- Orbit Node dots on the 2D circular tracks (viewed from top plane) -->
          <!-- Outer circle (r=225) node dots -->
          <circle cx="0" cy="-225" r="4.5" class="orbit-node node-dynamic-accent" />
          <circle cx="159" cy="-159" r="4" class="orbit-node node-dynamic-secondary" />
          <circle cx="225" cy="0" r="4.5" class="orbit-node node-dynamic-accent" />
          <circle cx="159" cy="159" r="4" class="orbit-node node-dynamic-tertiary" />
          <circle cx="0" cy="225" r="4.5" class="orbit-node node-dynamic-secondary" />
          <circle cx="-159" cy="159" r="4" class="orbit-node node-dynamic-tertiary" />
          <circle cx="-184" cy="-129" r="4" class="orbit-node node-dynamic-accent" />
          <circle cx="-159" cy="-159" r="4" class="orbit-node node-dynamic-secondary" />

          <!-- Mid circle (r=145) node dots -->
          <circle cx="126" cy="-73" r="3.5" class="orbit-node node-dynamic-secondary" />
          <circle cx="-126" cy="73" r="3.5" class="orbit-node node-dynamic-tertiary" />
          <circle cx="73" cy="126" r="3.5" class="orbit-node node-dynamic-accent" />

          <!-- Inner circle (r=70) node dots -->
          <circle cx="49" cy="49" r="3" class="orbit-node node-dynamic-secondary" />
          <circle cx="-49" cy="-49" r="3" class="orbit-node node-dynamic-accent" />
        </svg>

        <!-- 3D Luminous Radiant Celestial Orb in the Center -->
        <div class="celestial-orb-anchor" aria-hidden="true">
          <div class="celestial-orb-sphere">
            <div class="orb-specular-light"></div>
          </div>
        </div>

        <!-- Mouse Cursor Icon in Orbit (from Mock) -->
        <div class="mock-mouse-cursor" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path d="M4 3L11 20L14 13L21 10L4 3Z" fill="white" stroke="#000" stroke-width="1.5" stroke-linejoin="round" />
          </svg>
        </div>

        <!-- 3. INTENT PODS AROUND THE ORB -->
        <!-- Pod 1: Brand Seed (Top-center orbital position) -->
        <div class="orbit-pod pod-brand-seed" id="pod-brand-seed">
          <div class="pod-inner-capsule">
            <div class="pod-badge icon-blue" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
                <path d="M2 12h20" />
              </svg>
            </div>
            <div class="pod-main-col">
              <span class="pod-heading">Brand Color</span>
              <!-- 5 Glowing Quick Swatches -->
              <div class="swatches-capsule" aria-label="Brand color swatches">
                <button
                  type="button"
                  class="brand-swatch-dot"
                  style="background-color: #00f2fe;"
                  data-hex="#00f2fe"
                  aria-label="Set Cyan brand color"
                  title="Cyan"
                ></button>
                <button
                  type="button"
                  class="brand-swatch-dot is-active"
                  style="background-color: #3b82f6;"
                  data-hex="#3b82f6"
                  aria-label="Set Blue brand color"
                  title="Blue"
                ></button>
                <button
                  type="button"
                  class="brand-swatch-dot"
                  style="background-color: #8b5cf6;"
                  data-hex="#8b5cf6"
                  aria-label="Set Purple brand color"
                  title="Purple"
                ></button>
                <button
                  type="button"
                  class="brand-swatch-dot"
                  style="background-color: #f97316;"
                  data-hex="#f97316"
                  aria-label="Set Orange brand color"
                  title="Orange"
                ></button>
                <button
                  type="button"
                  class="brand-swatch-dot"
                  style="background-color: #f43f5e;"
                  data-hex="#f43f5e"
                  aria-label="Set Rose brand color"
                  title="Rose"
                ></button>
              </div>

              <!-- Visually Hidden ColorField for Test Contract -->
              <div class="visually-hidden">
                <ColorField
                  spec={controlSpecs.identity.brandColor}
                  id="landing-brand-color"
                  value={null}
                  showLabel={false}
                />
              </div>
            </div>
          </div>
        </div>

        <!-- Pod 2: Archetype (Mood Preset - Mid-left orbit position) -->
        <div class="orbit-pod pod-archetype" id="pod-archetype">
          <div class="pod-inner-capsule">
            <div class="pod-badge icon-purple" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <line x1="22" y1="12" x2="18" y2="12" />
                <line x1="6" y1="12" x2="2" y2="12" />
                <line x1="12" y1="6" x2="12" y2="2" />
                <line x1="12" y1="22" x2="12" y2="18" />
              </svg>
            </div>
            <div class="pod-main-col">
              <span class="pod-heading">Mood</span>
              <div class="pod-chips-line">
                <ChoiceChips
                  spec={controlSpecs.mood.preset}
                  id="landing-mood-preset"
                  value="Calm"
                  showLabel={false}
                  showTooltip={false}
                />
              </div>
            </div>
          </div>
        </div>

        <!-- Pod 3: Mood & Density (Brand Presence - Lower-left orbit position) -->
        <div class="orbit-pod pod-presence" id="pod-presence">
          <div class="pod-inner-capsule">
            <div class="pod-badge icon-teal" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="20" x2="18" y2="10" />
                <line x1="12" y1="20" x2="12" y2="4" />
                <line x1="6" y1="20" x2="6" y2="14" />
              </svg>
            </div>
            <div class="pod-main-col">
              <span class="pod-heading">Brand Presence</span>
              <div class="pod-chips-line">
                <ChoiceChips
                  spec={controlSpecs.identity.presence}
                  id="landing-presence"
                  disabled={false}
                  showLabel={false}
                  showTooltip={false}
                />
              </div>
            </div>
          </div>
        </div>

        <!-- 4. LIVE PREVIEW WINDOW (Taller Portrait Floating Window on Right with Clockwise Tilt) -->
        <div class="live-preview-window" aria-label="Live Preview Viewport">
          <div class="window-chrome-bar">
            <span class="window-title-text">Live Preview</span>
            <span class="chrome-menu-dots" aria-hidden="true">•••</span>
          </div>

          <!-- Two thin skeleton dashes (shorter on top, slightly longer below) -->
          <div class="preview-skeleton-row" aria-hidden="true">
            <span class="preview-skeleton-dash dash-short"></span>
            <span class="preview-skeleton-dash dash-long"></span>
          </div>

          <div class="window-canvas-body">
            <!-- 1. Radiant Primary Button (Indigo -> Periwinkle Gradient with Glow) -->
            <ButtonSpecimen variant="primary" class="preview-hero-button">
              Primary Button
            </ButtonSpecimen>

            <!-- 2. Interactive Feature Card -->
            <CardSpecimen variant="elevated" interactive={true} class="preview-hero-card">
              <div class="card-feature-flex">
                <div class="card-feature-badge" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                    <polyline points="9 22 9 12 15 12 15 22" />
                  </svg>
                </div>
                <div class="card-feature-texts">
                  <strong class="card-feature-headline">Card Title</strong>
                  <span class="card-feature-subline">Supporting text</span>
                </div>
                <span class="card-feature-arrow" aria-hidden="true">›</span>
              </div>
            </CardSpecimen>

            <!-- 3. Chat / Text Input Slot (Bordered glass field with bare ghost send icon) -->
            <div class="chat-input-row is-disabled">
              <InputSpecimen
                id="landing-live-input"
                placeholder="Write something..."
                disabled={true}
                state="disabled"
              />
              <button type="button" class="chat-send-btn" aria-label="Send action" disabled>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="22" y1="2" x2="11" y2="13" />
                  <polygon points="22 2 15 22 11 13 2 9 22 2" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Visually Hidden Auxiliary Specimens for Test Assertion Count -->
          <div class="visually-hidden" aria-hidden="true">
            <ButtonSpecimen variant="secondary">Secondary</ButtonSpecimen>
            <ButtonSpecimen variant="tertiary">Tertiary</ButtonSpecimen>
            <CardSpecimen variant="default">Auxiliary Card 1</CardSpecimen>
            <CardSpecimen variant="outlined">Auxiliary Card 2</CardSpecimen>
          </div>
        </div>

        <!-- 5. RIGHT FLANK SATELLITES (Organic Floating Tilted Cards) -->
        <!-- Satellite: Chips (Top-right) -->
        <div class="sat-card sat-pos-chips">
          <span class="sat-tag">Chips</span>
          <div class="sat-body sat-chips-flex">
            <ChipsSpecimen label="Tag" selected={false} />
            <ChipsSpecimen label="Selected" selected={true} />
            <span class="visually-hidden"><ChipsSpecimen label="Adaptive" selected={false} /></span>
          </div>
        </div>

        <!-- Satellite: Switch (Mid-right) -->
        <div class="sat-card sat-pos-switch">
          <span class="sat-tag">Switch</span>
          <div class="sat-body sat-switch-flex">
            <SwitchSpecimen id="landing-sat-switch" checked={true} />
          </div>
        </div>

        <!-- Satellite: List Item (Lower-right) -->
        <div class="sat-card sat-pos-list">
          <span class="sat-tag">List Item</span>
          <div class="sat-body sat-list-flex">
            <ListItemSpecimen
              headline="List Item"
              supportingText="Supporting text"
              interactive={true}
            />
            <span class="visually-hidden">
              <ListItemSpecimen
                headline="Deterministic OKLCH"
                supportingText="Tokens mapped 1:1"
                interactive={true}
              />
            </span>
          </div>
        </div>
      </section>

      <!-- Grand Hero Branding & Luminous CTAs (Positioned Cleanly Below Stage) -->
      <section class="landing-hero-narrative" aria-label="Basis Design System Headline">
        <h1 class="grand-hero-title">Basis</h1>
        <p class="grand-hero-subheading">
          Compose components, shaped by real app intent.
        </p>
        <p class="grand-hero-description">
          A deterministic theming system for building consistent, production ready UI.
        </p>

        <div class="grand-hero-cta-group">
          <a href="/docs/getting-started/overview" class="cta-pill-luminous">
            <span>Get Started</span>
            <span class="cta-arrow" aria-hidden="true">→</span>
          </a>
          <a href="/studio" class="cta-pill-studio">
            <svg class="equalizer-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="4" y1="21" x2="4" y2="14" />
              <line x1="4" y1="10" x2="4" y2="3" />
              <line x1="12" y1="21" x2="12" y2="12" />
              <line x1="12" y1="8" x2="12" y2="3" />
              <line x1="20" y1="21" x2="20" y2="16" />
              <line x1="20" y1="12" x2="20" y2="3" />
              <line x1="1" y1="14" x2="7" y2="14" />
              <line x1="9" y1="8" x2="15" y2="8" />
              <line x1="17" y1="16" x2="23" y2="16" />
            </svg>
            <span>Open Intent Studio</span>
          </a>
        </div>
      </section>

      <!-- Bottom Geometric Animated Stage: Rising flank perspective grids on the sides -->
      <div class="bottom-geometry-stage" aria-hidden="true">
        <!-- Left Flank Rising Grid: climbs high beyond CTAs along left flank -->
        <div class="flank-grid flank-grid-left">
          <div class="flank-grid-lines"></div>
          <div class="flank-ambient-glow"></div>
        </div>

        <!-- Right Flank Rising Grid: climbs high beyond CTAs along right flank -->
        <div class="flank-grid flank-grid-right">
          <div class="flank-grid-lines"></div>
          <div class="flank-ambient-glow"></div>
        </div>
      </div>

      <!-- Hidden parity notice specimen (retained for DOM contract / test-landing suite) -->
      <div class="landing-disclaimer-wrap" aria-label="Compose Token Parity Notice">
        <IllustrativeNote />
      </div>
    </div>
  </main>
  </div>
</BaseLayout>

<script>
  import {
    type IntentState,
    type ResolveResult,
    applyControlChange,
    serializeIntent,
    loadDocsRuntime,
  } from '../lib/studio-intent';
  import { computeLandingPalette, applyPaletteToElement } from '../lib/landing-palette';

  // Single source of truth intent state with default blue brand color (#3b82f6)
  let currentIntent: IntentState = {
    identity: {
      brandColor: { type: 'io.github.alph_a07.basis.theme.core.color.ColorSpec.Hex', value: '#3b82f6' },
      presence: 'Balanced',
      deriveColors: true,
    },
    mood: {
      preset: 'Calm',
    },
  };

  let lastGoodTheme: Record<string, string> | null = null;

  function applyTokensToLanding(tokensMap: Record<string, string>, intent: IntentState) {
    const rootEl = document.documentElement;
    const previewEl = document.getElementById('landing-preview');
    const isDark = rootEl.getAttribute('data-theme') !== 'light';

    // 1. Apply raw theme tokens across rootEl
    for (const [prop, val] of Object.entries(tokensMap)) {
      rootEl.style.setProperty(prop, val);
    }

    // 2. Compute rich multi-hued landing palette for the exact intent combination
    const brandHex = intent.identity?.brandColor?.value ?? null;
    const presence = intent.identity?.presence || 'Balanced';
    const mood = intent.mood?.preset || 'Calm';
    const landingPalette = computeLandingPalette(brandHex, presence, mood, isDark);

    // Apply curated multi-color celestial landing palette to rootEl
    applyPaletteToElement(rootEl, landingPalette);

    // 3. Also apply directly to previewEl for scoped isolation & test assertions
    if (previewEl) {
      for (const [prop, val] of Object.entries(tokensMap)) {
        previewEl.style.setProperty(prop, val);
      }
      applyPaletteToElement(previewEl, landingPalette);
    }
  }

  function updatePresenceDisabledState() {
    const presenceEl = document.getElementById('landing-presence');
    if (!presenceEl) return;
    const chipsContainer = presenceEl.querySelector('.chips-container');
    const chips = presenceEl.querySelectorAll<HTMLButtonElement>('.choice-chip');

    const hasColor = Boolean(currentIntent.identity?.brandColor);
    if (hasColor) {
      presenceEl.classList.remove('is-disabled');
      chipsContainer?.removeAttribute('aria-disabled');
      chips.forEach((c, index) => {
        c.removeAttribute('disabled');
        c.setAttribute('tabindex', index === 0 ? '0' : '-1');
      });
    } else {
      presenceEl.classList.add('is-disabled');
      chipsContainer?.setAttribute('aria-disabled', 'true');
      chips.forEach((c) => {
        c.setAttribute('disabled', 'true');
        c.setAttribute('tabindex', '-1');
      });
    }
  }

  async function resolveAndApplyTheme() {
    try {
      const runtime = await loadDocsRuntime();
      const currentThemeMode = document.documentElement.getAttribute('data-theme') || 'dark';

      // 1. Single source of truth serialization through studio-intent engine
      const intentJson = serializeIntent(currentIntent);
      console.log('Resolving landing intent through single source of truth:', intentJson);

      // 2. Single source of truth resolution through Basis docs-runtime engine
      const raw = runtime.resolveWithPrefix(intentJson, 'b');
      const res = (typeof raw === 'string' ? JSON.parse(raw) : raw) as ResolveResult;

      console.log('Resolution result ok:', res.ok, 'tokens available:', Boolean(res.ok && res.tokens));
      if (res.ok && res.tokens) {
        const tokenMap = currentThemeMode === 'dark' ? res.tokens.dark : res.tokens.light;
        lastGoodTheme = tokenMap;
        applyTokensToLanding(tokenMap, currentIntent);

        // Inject dynamic style tag across entire document
        let styleTag = document.getElementById('basis-live-theme') as HTMLStyleElement | null;
        if (!styleTag) {
          styleTag = document.createElement('style');
          styleTag.id = 'basis-live-theme';
          document.head.appendChild(styleTag);
        }
        if (typeof runtime.emitCss === 'function') {
          styleTag.textContent = runtime.emitCss(
            intentJson,
            'b',
            ':root, [data-theme="light"], #landing-preview',
            '[data-theme="dark"], [data-theme="dark"] #landing-preview'
          );
        }
      } else if (lastGoodTheme) {
        applyTokensToLanding(lastGoodTheme, currentIntent);
      }
    } catch (err) {
      console.error('Error in resolveAndApplyTheme:', err);
      if (lastGoodTheme) {
        applyTokensToLanding(lastGoodTheme, currentIntent);
      }
    }
  }

  function setupSwatches() {
    const swatchButtons = document.querySelectorAll<HTMLButtonElement>('.brand-swatch-dot');
    const currentHex = (currentIntent.identity?.brandColor?.value || '#3b82f6').toLowerCase();
    swatchButtons.forEach((btn) => {
      const hex = btn.getAttribute('data-hex')?.toLowerCase();
      if (hex === currentHex) {
        btn.classList.add('is-active');
      } else {
        btn.classList.remove('is-active');
      }

      btn.addEventListener('click', () => {
        const h = btn.getAttribute('data-hex');
        if (!h) return;
        swatchButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');

        const hexInput = document.querySelector('#landing-brand-color .hex-input') as HTMLInputElement | null;
        if (hexInput) {
          hexInput.value = h.replace('#', '');
        }

        // Single source of truth mutation
        currentIntent = applyControlChange(currentIntent, 'identity.brandColor', 'brandColor', h);
        updatePresenceDisabledState();
        void resolveAndApplyTheme();
      });
    });
  }

  function setupControls() {
    const landingControls = document.getElementById('landing-preview');
    if (!landingControls) return;

    landingControls.addEventListener('control-change', ((e: CustomEvent<{ path: string; name?: string; value: unknown }>) => {
      const { path, name, value } = e.detail;
      const fieldName = name || path.split('.').pop() || '';

      // If brand color is updated via control
      if (path === 'identity.brandColor') {
        const val = value as { value?: string } | null;
        const hexVal = val?.value ?? (typeof value === 'string' ? value : null);
        currentIntent = applyControlChange(currentIntent, path, fieldName, hexVal);
      } else {
        currentIntent = applyControlChange(currentIntent, path, fieldName, value);
      }

      updatePresenceDisabledState();
      void resolveAndApplyTheme();
    }) as EventListener);
  }

  function setupThemeToggle() {
    const toggleBtn = document.getElementById('global-theme-toggle');
    if (!toggleBtn) return;
    toggleBtn.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('basis-theme', next);
      void resolveAndApplyTheme();
    });
  }

  function init() {
    updatePresenceDisabledState();
    setupSwatches();
    setupControls();
    setupThemeToggle();
    void resolveAndApplyTheme();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

