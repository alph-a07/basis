---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const components = await getCollection('components');
  const paths: any[] = [];

  for (const comp of components) {
    const tabs = ['', 'api', 'overrides', 'accessibility'];
    for (const tab of tabs) {
      const slug = tab ? `components/${comp.id}/${tab}` : `components/${comp.id}`;
      paths.push({
        params: { slug },
        props: { component: comp, activeTab: tab || 'overview' },
      });
    }
  }

  return paths;
}

const { component: componentEntry, activeTab } = Astro.props;
const component = componentEntry.data;
---

<BaseLayout title={`${component.name} — ${activeTab}`}>
  <div style="display: flex; min-height: 100vh;">
    <aside style="width: 260px; border-right: 1px solid #30363d; padding: 2rem 1.5rem;">
      <h2 style="font-size: 1.1rem; margin-top: 0;">Components</h2>
      <ul style="list-style: none; padding: 0; margin: 0;">
        <li>
          <a
            href={`/docs/components/${component.id}`}
            style={`color: ${activeTab === 'overview' ? '#58a6ff' : '#c9d1d9'}; text-decoration: none; font-weight: 500;`}
          >
            {component.name}
          </a>
        </li>
      </ul>
    </aside>

    <main data-pagefind-body style="flex: 1; padding: 2rem 3rem; max-width: 900px;">
      <header style="margin-bottom: 2rem; border-bottom: 1px solid #30363d; padding-bottom: 1.5rem;">
        <span style="font-size: 0.85rem; color: #8b949e; text-transform: uppercase; font-weight: 600;">
          {component.family} · {component.lifecycle.status}
        </span>
        <h1 style="font-size: 2.5rem; margin: 0.5rem 0 1rem 0;">{component.name}</h1>
        <p style="font-size: 1.15rem; color: #8b949e; line-height: 1.6; margin: 0;">
          {component.summary}
        </p>

        <nav style="display: flex; gap: 1.5rem; margin-top: 1.5rem;">
          {['overview', 'api', 'overrides', 'accessibility'].map((tab) => {
            const href = tab === 'overview'
              ? `/docs/components/${component.id}`
              : `/docs/components/${component.id}/${tab}`;
            const isActive = activeTab === tab;
            return (
              <a
                href={href}
                style={`text-decoration: none; text-transform: capitalize; padding-bottom: 0.5rem; font-weight: 600; color: ${
                  isActive ? '#58a6ff' : '#8b949e'
                }; border-bottom: 2px solid ${isActive ? '#58a6ff' : 'transparent'};`}
              >
                {tab}
              </a>
            );
          })}
        </nav>
      </header>

      <section>
        {activeTab === 'overview' && (
          <div>
            <h2>Quick Start</h2>
            <pre style="background: #161b22; padding: 1rem; border-radius: 6px; overflow-x: auto;">
              <code>{component.overview.quickStartSample}</code>
            </pre>
            <h3>Anatomy ({component.overview.anatomy.parts.length} parts)</h3>
            <ul>
              {component.overview.anatomy.parts.map((part: any) => (
                <li>
                  <strong>{part.name}</strong> ({part.id}): {part.description}
                </li>
              ))}
            </ul>
          </div>
        )}

        {activeTab === 'api' && (
          <div>
            <h2>API Signatures</h2>
            {component.api.signatures.map((sig: any) => (
              <pre style="background: #161b22; padding: 1rem; border-radius: 6px; overflow-x: auto;">
                <code>{sig.declaration}</code>
              </pre>
            ))}
          </div>
        )}

        {activeTab === 'overrides' && (
          <div>
            <h2>Overrides & Patches</h2>
            <p>Extra family: {component.overrides.extraFamily || 'None'}</p>
            <h3>Universal Fields</h3>
            <ul>
              {component.overrides.universalFields.map((field: string) => (
                <li><code>{field}</code></li>
              ))}
            </ul>
          </div>
        )}

        {activeTab === 'accessibility' && (
          <div>
            <h2>Accessibility Facts</h2>
            <p>Role: <code>{component.accessibility.role}</code></p>
            <p>Minimum touch target: {component.accessibility.touchTarget.minWidthDp}dp x {component.accessibility.touchTarget.minHeightDp}dp</p>
            {component.accessibility.report && (
              <div>
                <h3>Test Report ({component.accessibility.report.status})</h3>
                <ul>
                  {component.accessibility.report.checks.map((check: string) => (
                    <li>{check}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )}
      </section>
    </main>
  </div>
</BaseLayout>
