---
import DocsLayout from '../../layouts/DocsLayout.astro';
import ComponentPage from '../../components/templates/ComponentPage.astro';
import ModifierPage from '../../components/templates/ModifierPage.astro';
import { getCollection, render } from 'astro:content';
import type { TocItem } from '../../types/navigation';

export async function getStaticPaths() {
  const components = await getCollection('components');
  const sidecars = await getCollection('sidecars');
  const docsEntries = await getCollection('docs');
  const paths: any[] = [];

  for (const comp of components) {
    const sidecar = sidecars.find((s) => s.data.id === comp.data.id);

    if (comp.data.kind === 'modifier') {
      paths.push({
        params: { slug: `modifiers/${comp.data.id}` },
        props: {
          type: 'modifier',
          modifier: comp,
          sidecar,
        },
      });
    } else {
      const tabs = ['', 'api', 'overrides', 'accessibility'];
      for (const tab of tabs) {
        const slug = tab ? `components/${comp.data.id}/${tab}` : `components/${comp.data.id}`;
        paths.push({
          params: { slug },
          props: {
            type: 'component',
            component: comp,
            sidecar,
            activeTab: tab || 'overview',
          },
        });
      }
    }
  }

  for (const doc of docsEntries) {
    paths.push({
      params: { slug: doc.id },
      props: {
        type: 'doc',
        doc,
      },
    });
  }

  return paths;
}

const props = Astro.props;

let pageTitle = '';
let pageDescription = '';
let headings: TocItem[] = [];
let RenderedContent: any = null;

if (props.type === 'component') {
  const component = props.component.data;
  const activeTab = props.activeTab;
  pageTitle = `${component.name} — ${activeTab.charAt(0).toUpperCase() + activeTab.slice(1)}`;
  pageDescription = component.summary;

  if (activeTab === 'overview') {
    headings = [
      { depth: 2, slug: 'quick-start', text: 'Quick Start' },
      { depth: 2, slug: 'anatomy', text: 'Anatomy' },
      { depth: 2, slug: 'variants', text: 'Variants & States' },
      { depth: 2, slug: 'guidelines', text: 'Usage Guidelines' },
    ];
  } else if (activeTab === 'api') {
    headings = [
      { depth: 2, slug: 'signatures', text: 'Signatures & Parameters' },
    ];
  } else if (activeTab === 'overrides') {
    headings = [
      { depth: 2, slug: 'universal-fields', text: 'Universal Overrides' },
    ];
  } else if (activeTab === 'accessibility') {
    headings = [
      { depth: 2, slug: 'accessibility-facts', text: 'Accessibility Facts & Contracts' },
    ];
  }
} else if (props.type === 'modifier') {
  const modifier = props.modifier.data;
  pageTitle = `${modifier.name} — Modifier`;
  pageDescription = modifier.summary;
  headings = [
    ...(modifier.overview?.quickStartSample ? [{ depth: 2, slug: 'quick-start', text: 'Quick Start' }] : []),
    ...(modifier.api ? [{ depth: 2, slug: 'signatures', text: 'API Signatures & Parameters' }] : []),
    ...(modifier.accessibility ? [{ depth: 2, slug: 'accessibility', text: 'Accessibility Behavior' }] : []),
    ...(props.sidecar?.data?.guidelines ? [{ depth: 2, slug: 'guidelines', text: 'Usage Guidelines' }] : []),
  ];
} else if (props.type === 'doc') {
  const rendered = await render(props.doc);
  RenderedContent = rendered.Content;
  pageTitle = `${props.doc.data.title} — ${props.doc.data.section}`;
  pageDescription = props.doc.data.description || `${props.doc.data.title} documentation for Basis.`;
  headings = rendered.headings.map((h: any) => ({
    depth: h.depth,
    slug: h.slug,
    text: h.text,
  }));
}
---

<DocsLayout title={pageTitle} description={pageDescription} headings={headings}>
  {props.type === 'component' ? (
    <ComponentPage
      component={props.component.data}
      sidecar={props.sidecar}
      activeTab={props.activeTab}
    />
  ) : props.type === 'modifier' ? (
    <ModifierPage
      modifier={props.modifier.data}
      sidecar={props.sidecar}
    />
  ) : (
    <article class="prose-doc">
      <header class="doc-header">
        <div class="header-meta">
          <span class="section-badge">{props.doc.data.section}</span>
          {props.doc.data.status === 'stub' && (
            <span class="stub-badge" title="This page is a documentation stub">Stub</span>
          )}
        </div>
        <h1 class="doc-title">{props.doc.data.title}</h1>
        {props.doc.data.description && (
          <p class="doc-summary">{props.doc.data.description}</p>
        )}
      </header>

      <div class="doc-body">
        {RenderedContent && <RenderedContent />}
      </div>
    </article>
  )}
</DocsLayout>

<style>
  .prose-doc {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .doc-header {
    border-bottom: 1px solid var(--docs-border-subtle, #21262d);
    padding-bottom: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .section-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--docs-text-muted, #8b949e);
  }

  .stub-badge {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.125rem 0.45rem;
    border-radius: 4px;
    background: color-mix(in srgb, var(--docs-accent) 12%, transparent);
    color: var(--docs-accent, #58a6ff);
    border: 1px solid color-mix(in srgb, var(--docs-accent) 25%, transparent);
  }

  .doc-title {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0.1rem 0 0.25rem 0;
    color: var(--docs-text, #e6edf3);
  }

  .doc-summary {
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--docs-text-muted, #8b949e);
    margin: 0;
  }

  .doc-body {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    line-height: 1.6;
    color: var(--docs-text, #c9d1d9);
  }

  .doc-body :global(h2) {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
    margin: 1.15rem 0 0.2rem 0;
    color: var(--docs-text, #e6edf3);
    scroll-margin-top: 5rem;
  }

  .doc-body :global(h2:first-child) {
    margin-top: 0;
  }

  .doc-body :global(h3) {
    font-size: 1.08rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    line-height: 1.35;
    margin: 0.75rem 0 0.15rem 0;
    color: var(--docs-text, #e6edf3);
    scroll-margin-top: 5rem;
  }

  .doc-body :global(h3:first-child) {
    margin-top: 0;
  }

  .doc-body :global(hr) {
    border: none;
    border-top: 1px solid var(--docs-border-subtle, #21262d);
    margin: 0.65rem 0;
  }

  .doc-body :global(p) {
    margin: 0;
    line-height: 1.6;
  }

  .doc-body :global(a) {
    color: var(--docs-link, #58a6ff);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, var(--docs-link, #58a6ff) 40%, transparent);
    font-weight: 500;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  .doc-body :global(a:visited) {
    color: var(--docs-link-visited, var(--docs-link, #58a6ff));
    text-decoration-color: color-mix(in srgb, var(--docs-link-visited, var(--docs-link, #58a6ff)) 40%, transparent);
  }

  .doc-body :global(a:hover) {
    color: var(--docs-link-hover, #79c0ff);
    text-decoration-color: var(--docs-link-hover, #79c0ff);
  }

  .doc-body :global(a:focus-visible) {
    outline: 2px solid var(--docs-focus-ring);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .doc-body :global(a code) {
    color: inherit;
  }

  .doc-body :global(ul),
  .doc-body :global(ol) {
    margin: 0;
    padding-left: 1.35rem;
  }

  .doc-body :global(li) {
    margin-bottom: 0.35rem;
    line-height: 1.55;
  }

  .doc-body :global(li:last-child) {
    margin-bottom: 0;
  }

  .doc-body :global(code) {
    font-family: var(--docs-font-mono, ui-monospace, monospace);
    font-size: 0.875em;
    background: var(--docs-code-bg, rgba(255, 255, 255, 0.05));
    border: 1px solid var(--docs-code-border, rgba(255, 255, 255, 0.1));
    border-radius: 4px;
    padding: 0.15em 0.35em;
    color: var(--docs-accent, #58a6ff);
  }

  .doc-body :global(pre) {
    background: var(--docs-code-bg, #161b22);
    border: 1px solid var(--docs-code-border, #21262d);
    border-radius: 8px;
    padding: 0.85rem 1.15rem;
    overflow-x: auto;
    font-family: var(--docs-font-mono, ui-monospace, monospace);
    font-size: 0.875rem;
    margin: 0.25rem 0;
  }

  .doc-body :global(pre code) {
    background: transparent;
    border: none;
    padding: 0;
    color: var(--docs-text, #e6edf3);
  }

  .doc-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0.35rem 0;
    font-size: 0.875rem;
  }

  .doc-body :global(th),
  .doc-body :global(td) {
    padding: 0.55rem 0.75rem;
    text-align: left;
    border: 1px solid var(--docs-border-subtle, #21262d);
  }

  .doc-body :global(th) {
    background: var(--docs-surface-sunken, #161b22);
    font-weight: 600;
    color: var(--docs-text, #e6edf3);
  }

  .doc-body :global(tr:nth-child(even)) {
    background: var(--docs-table-row-alt, rgba(255, 255, 255, 0.015));
  }

  .doc-body :global(.mermaid-container) {
    display: flex;
    justify-content: center;
    align-items: center;
    background: var(--docs-code-bg, #161b22);
    border: 1px solid var(--docs-code-border, #21262d);
    border-radius: 8px;
    padding: 1.5rem 1.25rem;
    margin: 1rem 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .doc-body :global(.mermaid-container pre.mermaid) {
    display: flex;
    justify-content: center;
    align-items: center;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    width: 100%;
    min-width: fit-content;
  }

  .doc-body :global(.mermaid-container svg) {
    display: block;
    height: auto;
    max-width: 100%;
  }

  .doc-body :global(.mermaid-container .node rect),
  .doc-body :global(.mermaid-container .node polygon),
  .doc-body :global(.mermaid-container .node circle) {
    rx: 6px;
    ry: 6px;
  }

  .doc-body :global(.mermaid-container .nodeLabel) {
    color: var(--docs-text, #f0f6fc) !important;
    font-size: 13.5px !important;
    font-weight: 500 !important;
    line-height: 1.45 !important;
    text-align: center;
  }

  .doc-body :global(.mermaid-container .nodeLabel p) {
    margin: 0 !important;
    padding: 0 !important;
    color: inherit !important;
    font-size: inherit !important;
    font-weight: inherit !important;
    line-height: inherit !important;
  }

  .doc-body :global(.mermaid-container .cluster rect) {
    rx: 8px;
    ry: 8px;
    stroke-width: 1px !important;
  }

  .doc-body :global(.mermaid-container .cluster-label span) {
    color: var(--docs-accent, #58a6ff) !important;
    font-size: 12px !important;
    font-weight: 600 !important;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>

<script>
  import mermaid from 'mermaid';

  let isRendering = false;

  async function renderMermaid() {
    if (isRendering) return;
    const preBlocks = document.querySelectorAll<HTMLElement>(
      '.doc-body pre[data-language="mermaid"], .doc-body pre.mermaid'
    );
    if (preBlocks.length === 0) return;

    isRendering = true;
    const isDark = document.documentElement.getAttribute('data-theme') !== 'light';

    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'loose',
      theme: 'base',
      themeVariables: isDark
        ? {
            darkMode: true,
            background: 'transparent',
            fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
            fontSize: '13.5px',
            primaryColor: '#21262d',
            primaryTextColor: '#f0f6fc',
            primaryBorderColor: '#388bfd',
            lineColor: '#58a6ff',
            secondaryColor: '#161b22',
            secondaryTextColor: '#e6edf3',
            secondaryBorderColor: '#30363d',
            tertiaryColor: '#0d1117',
            tertiaryTextColor: '#c9d1d9',
            tertiaryBorderColor: '#30363d',
            clusterBkg: '#161b22',
            clusterBorder: '#30363d',
            titleColor: '#58a6ff',
            edgeLabelBackground: '#161b22',
            nodeBorder: '#388bfd',
            nodeTextColor: '#f0f6fc',
          }
        : {
            darkMode: false,
            background: 'transparent',
            fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
            fontSize: '13.5px',
            primaryColor: '#f6f8fa',
            primaryTextColor: '#1f2328',
            primaryBorderColor: '#0969da',
            lineColor: '#0969da',
            secondaryColor: '#ffffff',
            secondaryTextColor: '#24292f',
            secondaryBorderColor: '#d0d7de',
            tertiaryColor: '#f6f8fa',
            tertiaryTextColor: '#57606a',
            tertiaryBorderColor: '#d0d7de',
            clusterBkg: '#f6f8fa',
            clusterBorder: '#d0d7de',
            titleColor: '#0969da',
            edgeLabelBackground: '#ffffff',
            nodeBorder: '#0969da',
            nodeTextColor: '#1f2328',
          },
      flowchart: {
        htmlLabels: true,
        curve: 'basis',
        nodeSpacing: 40,
        rankSpacing: 40,
        wrappingWidth: 380,
      },
    });

    const nodesToRender: HTMLElement[] = [];

    preBlocks.forEach((preEl) => {
      const rawCode = preEl.textContent?.trim() || '';
      if (!rawCode) return;

      const container = document.createElement('div');
      container.className = 'mermaid-container';
      container.setAttribute('data-original-code', rawCode);

      const diagramEl = document.createElement('pre');
      diagramEl.className = 'mermaid';
      diagramEl.textContent = rawCode;

      container.appendChild(diagramEl);
      preEl.replaceWith(container);
      nodesToRender.push(diagramEl);
    });

    if (nodesToRender.length > 0) {
      try {
        await mermaid.run({
          nodes: nodesToRender,
        });
      } catch (err) {
        console.error('Mermaid render error:', err);
      }
    }

    isRendering = false;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderMermaid);
  } else {
    renderMermaid();
  }
  document.addEventListener('astro:page-load', renderMermaid);

  const themeObserver = new MutationObserver((mutations) => {
    for (const m of mutations) {
      if (m.type === 'attributes' && m.attributeName === 'data-theme') {
        const containers = document.querySelectorAll<HTMLElement>(
          '.doc-body .mermaid-container[data-original-code]'
        );
        containers.forEach((c) => {
          const code = c.getAttribute('data-original-code') || '';
          const pre = document.createElement('pre');
          pre.setAttribute('data-language', 'mermaid');
          pre.textContent = code;
          c.replaceWith(pre);
        });
        renderMermaid();
      }
    }
  });
  themeObserver.observe(document.documentElement, { attributes: true });
</script>
