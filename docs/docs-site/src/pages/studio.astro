---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import ReportDrawer from '../components/studio/ReportDrawer.astro';
import { loadIntentDoc } from '../lib/load-intent';
import { deriveControlSpecs } from '../lib/control-generator';
import ChoiceChips from '../components/controls/ChoiceChips.astro';
import KnobSlider from '../components/controls/KnobSlider.astro';
import ColorField from '../components/controls/ColorField.astro';
import ToggleControl from '../components/controls/ToggleControl.astro';
import ColorListField from '../components/controls/ColorListField.astro';

const intentDoc = loadIntentDoc();
const controlSpecs = deriveControlSpecs(intentDoc);
---

<BaseLayout title="Intent Studio — Basis">
  <div class="studio-app" data-pagefind-body>
    <!-- Top bar: Full-bleed route without sidebar per locked decisions -->
    <header class="studio-topbar" aria-label="Studio top navigation">
      <div class="topbar-left">
        <a href="/" class="brand-link" aria-label="Basis Home">
          <svg class="brand-logo" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="4" stroke="var(--docs-accent, #58a6ff)" stroke-width="2" />
            <circle cx="12" cy="12" r="4" fill="var(--docs-accent, #58a6ff)" />
          </svg>
          <span class="brand-title">Basis</span>
        </a>
        <span class="studio-badge">Studio</span>
      </div>

      <div class="topbar-actions">
        <!-- Toggle Controls (panel on desktop, bottom sheet on mobile) -->
        <button
          type="button"
          id="studio-toggle-controls"
          class="studio-btn btn-secondary btn-icon-text"
          aria-label="Toggle controls panel"
          aria-controls="studio-controls-panel"
          aria-expanded="false"
          title="Toggle controls (Alt+C)"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="4" y1="21" x2="4" y2="14" />
            <line x1="4" y1="10" x2="4" y2="3" />
            <line x1="12" y1="21" x2="12" y2="12" />
            <line x1="12" y1="8" x2="12" y2="3" />
            <line x1="20" y1="21" x2="20" y2="16" />
            <line x1="20" y1="12" x2="20" y2="3" />
            <line x1="1" y1="14" x2="7" y2="14" />
            <line x1="9" y1="8" x2="15" y2="8" />
            <line x1="17" y1="16" x2="23" y2="16" />
          </svg>
          <span>Controls</span>
        </button>

        <!-- Toggle Report Drawer -->
        <button
          type="button"
          id="studio-toggle-report"
          class="studio-btn btn-secondary btn-icon-text"
          aria-label="Toggle resolution report drawer"
          aria-controls="studio-report-drawer"
          aria-expanded="false"
          title="Toggle report drawer (Alt+R)"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
            <line x1="16" y1="13" x2="8" y2="13" />
            <line x1="16" y1="17" x2="8" y2="17" />
            <polyline points="10 9 9 9 8 9" />
          </svg>
          <span>Report</span>
        </button>

        <ThemeToggle />

        <button type="button" id="studio-reset-btn" class="studio-btn btn-secondary" aria-label="Reset theme settings">
          Reset
        </button>
        <button type="button" id="studio-copy-kotlin-btn" class="studio-btn btn-secondary" aria-label="Copy Kotlin code to clipboard">
          Copy Kotlin
        </button>
        <button type="button" id="studio-share-btn" class="studio-btn btn-primary" aria-label="Share current theme configuration">
          Share
        </button>
        <a href="/docs/getting-started/overview" class="studio-btn btn-docs" aria-label="Go to documentation">
          Docs
        </a>
      </div>
    </header>

    <!-- Mobile Bottom Sheet Backdrop -->
    <div id="controls-sheet-backdrop" class="sheet-backdrop" aria-hidden="true"></div>

    <main id="studio-main" class="studio-main">
      <!-- Control Generator Panel: Controls derived from Intent schema & vocabulary -->
      <!-- On narrow screens (< 900px), becomes a bottom sheet -->
      <aside
        id="studio-controls-panel"
        class="studio-controls-panel"
        aria-label="Theme Intent Controls"
        data-open="false"
      >
        <div class="sheet-header">
          <div class="sheet-drag-handle" aria-hidden="true">
            <div class="drag-bar"></div>
          </div>
          <div class="sheet-title-bar">
            <h2 class="sheet-title">Theme Intent Controls</h2>
            <button
              type="button"
              id="controls-close-btn"
              class="sheet-close-btn"
              aria-label="Close controls panel"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M18 6L6 18M6 6l12 12" />
              </svg>
            </button>
          </div>
        </div>

        <div class="sheet-content">
          <div class="controls-section">
            <h2 class="section-heading">Identity</h2>
            <ColorField spec={controlSpecs.identity.brandColor} />
            <ChoiceChips spec={controlSpecs.identity.presence} />
            <ToggleControl spec={controlSpecs.identity.deriveColors} />
            <ColorListField spec={controlSpecs.identity.supportingColors} />
          </div>

          <div class="controls-section">
            <h2 class="section-heading">Mood Preset</h2>
            <ChoiceChips spec={controlSpecs.mood.preset} />
          </div>

          <div class="controls-section">
            <h2 class="section-heading">Mood Knobs</h2>
            <p class="section-note">Sparse biases over preset. Unset knobs inherit the preset profile.</p>
            {controlSpecs.mood.knobs.map((knob) => (
              <KnobSlider spec={knob} />
            ))}
          </div>

          <div class="controls-section">
            <h2 class="section-heading">Domain & Context</h2>
            <ChoiceChips spec={controlSpecs.domain.domains} />
            <ChoiceChips spec={controlSpecs.domain.interactions} />
          </div>
        </div>
      </aside>

      <!-- Scene Viewport: Housing the live preview workspace -->
      <section id="studio-viewport" class="studio-viewport" aria-label="Scene Preview Viewport">
        <!-- Localized Studio Preview Scope: uses deferred local --b-* intent resolution -->
        <div class="studio-workspace basis-preview-scope" id="studio-preview" data-scope="preview">
          <div class="studio-placeholder">
            <h1>Intent Studio Shell</h1>
            <p>Full-bleed workspace for live intent exploration and real-time Kotlin token export.</p>
          </div>
        </div>
      </section>

      <!-- Report Drawer: Slide-over inspection drawer -->
      <ReportDrawer />
    </main>
  </div>
</BaseLayout>

<script type="module">
  // Live Studio intent store: controls -> debounced resolve -> --b-* preview scope + report.
  import { createStudioIntentStore, bindControlEvents, loadDocsRuntime } from '../lib/studio-intent';

  function applyTokensToScope(el, result) {
    if (!result?.ok || !result.tokens) return;
    const theme = document.documentElement.getAttribute('data-theme') || 'dark';
    const map = theme === 'dark' ? result.tokens.dark : result.tokens.light;
    for (const [key, value] of Object.entries(map)) {
      el.style.setProperty(key, value);
    }
  }

  function updateReportDrawer(result, store) {
    const statusBadge = document.getElementById('report-status-badge');
    const violationsCount = document.getElementById('report-violations-count');
    const violationsContainer = document.getElementById('report-violations-container');
    const modesVal = document.getElementById('report-meta-modes');
    const presetVal = document.getElementById('report-meta-preset');

    if (presetVal && store?.intent?.mood?.preset) {
      presetVal.textContent = store.intent.mood.preset;
    }

    if (!result) return;

    if (result.ok) {
      if (statusBadge) {
        statusBadge.className = 'report-status-badge status-valid';
        statusBadge.textContent = 'Valid';
      }
      if (violationsCount) violationsCount.textContent = '0';
      if (violationsContainer) {
        violationsContainer.innerHTML = `
          <div class="violations-empty">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="empty-icon" aria-hidden="true">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
              <polyline points="22 4 12 14.01 9 11.01" />
            </svg>
            <p>No violations detected. Intent conforms to design system contracts.</p>
          </div>
        `;
      }
      if (modesVal && result.report?.modes) {
        modesVal.textContent = result.report.modes.join(', ');
      }
    } else {
      const count = result.violations?.length || 0;
      if (statusBadge) {
        statusBadge.className = 'report-status-badge status-violations';
        statusBadge.textContent = `${count} Warning${count > 1 ? 's' : ''}`;
      }
      if (violationsCount) violationsCount.textContent = String(count);
      if (violationsContainer) {
        violationsContainer.innerHTML = (result.violations || [])
          .map(
            (v) => `
            <div class="violation-item" role="alert" style="padding: 0.625rem 0.75rem; background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.25); border-radius: 6px; font-size: 0.8125rem;">
              <div style="font-weight: 600; color: #ef4444; font-size: 0.75rem; font-family: monospace;">[${v.path}]</div>
              <div style="color: var(--docs-text); margin-top: 0.25rem;">${v.message}</div>
            </div>
          `
          )
          .join('');
      }
    }
  }

  function initStudio() {
    const panelEl = document.getElementById('studio-controls-panel');
    const previewEl = document.getElementById('studio-preview');
    const reportDrawerEl = document.getElementById('studio-report-drawer');
    const toggleControlsBtn = document.getElementById('studio-toggle-controls');
    const toggleReportBtn = document.getElementById('studio-toggle-report');
    const controlsCloseBtn = document.getElementById('controls-close-btn');
    const reportCloseBtn = document.getElementById('report-close-btn');
    const controlsBackdrop = document.getElementById('controls-sheet-backdrop');
    const reportBackdrop = document.getElementById('report-drawer-backdrop');
    const copyReportJsonBtn = document.getElementById('report-copy-json-btn');

    if (!panelEl || !previewEl) return;

    const isNarrow = () => window.matchMedia('(max-width: 900px)').matches;

    // Controls panel / bottom sheet toggling
    function setControlsOpen(open) {
      panelEl.setAttribute('data-open', open ? 'true' : 'false');
      toggleControlsBtn?.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (isNarrow()) {
        panelEl.setAttribute('aria-hidden', open ? 'false' : 'true');
        if (controlsBackdrop) {
          if (open) controlsBackdrop.classList.add('is-active');
          else controlsBackdrop.classList.remove('is-active');
        }
      } else {
        panelEl.setAttribute('aria-hidden', 'false');
      }
      if (open && isNarrow()) {
        panelEl.focus();
      }
    }

    // Report drawer toggling
    function setReportOpen(open) {
      if (!reportDrawerEl) return;
      reportDrawerEl.setAttribute('data-open', open ? 'true' : 'false');
      reportDrawerEl.setAttribute('aria-hidden', open ? 'false' : 'true');
      toggleReportBtn?.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (reportBackdrop) {
        if (open) reportBackdrop.classList.add('is-active');
        else reportBackdrop.classList.remove('is-active');
      }
      if (open) {
        reportDrawerEl.focus();
      }
    }

    toggleControlsBtn?.addEventListener('click', () => {
      const current = panelEl.getAttribute('data-open') === 'true';
      setControlsOpen(!current);
    });

    controlsCloseBtn?.addEventListener('click', () => {
      setControlsOpen(false);
      toggleControlsBtn?.focus();
    });

    controlsBackdrop?.addEventListener('click', () => {
      setControlsOpen(false);
      toggleControlsBtn?.focus();
    });

    toggleReportBtn?.addEventListener('click', () => {
      const current = reportDrawerEl?.getAttribute('data-open') === 'true';
      setReportOpen(!current);
    });

    reportCloseBtn?.addEventListener('click', () => {
      setReportOpen(false);
      toggleReportBtn?.focus();
    });

    reportBackdrop?.addEventListener('click', () => {
      setReportOpen(false);
      toggleReportBtn?.focus();
    });

    // Keyboard Shortcuts: Alt+C, Alt+R, Escape
    window.addEventListener('keydown', (e) => {
      const activeTag = (document.activeElement?.tagName || '').toLowerCase();
      const isInput = activeTag === 'input' || activeTag === 'textarea' || document.activeElement?.isContentEditable;

      if (e.key === 'Escape') {
        if (reportDrawerEl?.getAttribute('data-open') === 'true') {
          setReportOpen(false);
          toggleReportBtn?.focus();
          e.preventDefault();
          return;
        }
        if (panelEl.getAttribute('data-open') === 'true' && isNarrow()) {
          setControlsOpen(false);
          toggleControlsBtn?.focus();
          e.preventDefault();
          return;
        }
      }

      if (e.altKey && (e.key === 'c' || e.key === 'C')) {
        e.preventDefault();
        const current = panelEl.getAttribute('data-open') === 'true';
        setControlsOpen(!current);
        return;
      }

      if (e.altKey && (e.key === 'r' || e.key === 'R')) {
        e.preventDefault();
        const current = reportDrawerEl?.getAttribute('data-open') === 'true';
        setReportOpen(!current);
        return;
      }
    });

    // Create studio intent store
    const setState = () => {};
    const store = createStudioIntentStore(setState);

    // Bind controls
    const unbind = bindControlEvents(panelEl, store);

    const observe = () => {
      applyTokensToScope(previewEl, store.lastGood ?? store.current ?? null);
      updateReportDrawer(store.current, store);
    };

    panelEl.addEventListener('control-change', () => {
      observe();
    });

    // Top bar actions
    const resetBtn = document.getElementById('studio-reset-btn');
    const copyBtn = document.getElementById('studio-copy-kotlin-btn');
    const shareBtn = document.getElementById('studio-share-btn');

    resetBtn?.addEventListener('click', () => {
      store.reset();
      previewEl.style.cssText = '';
      observe();
    });

    copyBtn?.addEventListener('click', async () => {
      if (!store.current?.ok) return;
      const intent = store.intent;
      const kotlin = buildKotlinFromIntent(intent);
      await navigator.clipboard.writeText(kotlin);
      copyBtn.textContent = 'Copied!';
      setTimeout(() => { copyBtn.textContent = 'Copy Kotlin'; }, 2000);
    });

    shareBtn?.addEventListener('click', () => {
      const json = JSON.stringify(store.intent, null, 0);
      const encoded = btoa(json);
      const url = `${window.location.origin}${window.location.pathname}#v1.${encoded}`;
      navigator.clipboard.writeText(url).then(() => {
        shareBtn.textContent = 'Link copied!';
        setTimeout(() => { shareBtn.textContent = 'Share'; }, 2000);
      });
    });

    copyReportJsonBtn?.addEventListener('click', async () => {
      const payload = store.current ? JSON.stringify(store.current, null, 2) : JSON.stringify(store.intent, null, 2);
      await navigator.clipboard.writeText(payload);
      copyReportJsonBtn.textContent = 'Copied!';
      setTimeout(() => {
        copyReportJsonBtn.innerHTML = `
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
          </svg>
          <span>Copy JSON</span>
        `;
      }, 2000);
    });

    // Initial resolve
    void loadDocsRuntime().then(() => observe()).catch(() => { /* last-good fallback */ });

    return () => {
      unbind();
    };
  }

  function buildKotlinFromIntent(intent) {
    const i = intent;
    const lines = [];
    lines.push('BasisIntent(');
    if (i?.identity) {
      lines.push('  identity = IdentityIntent(');
      if (i.identity.brandColor) lines.push(`    brandColor = ColorSpec.Hex("${i.identity.brandColor.value}"),`);
      if (i.identity.presence) lines.push(`    presence = BrandPresence.${i.identity.presence},`);
      lines.push(`    deriveColors = ${i.identity.deriveColors ?? true}`);
      lines.push('  ),');
    }
    if (i?.mood && (i.mood.preset || (i.mood.knobs && Object.keys(i.mood.knobs).length))) {
      lines.push('  mood = MoodIntent(');
      if (i.mood.preset) lines.push(`    preset = MoodPreset.${i.mood.preset},`);
      if (i.mood.knobs) {
        const knobLines = Object.entries(i.mood.knobs)
          .filter(([, v]) => v !== null && v !== undefined)
          .map(([k, v]) => `      ${k} = ${v}f,`);
        if (knobLines.length) {
          lines.push('    knobs = MoodKnobs(');
          lines.push(...knobLines);
          lines.push('    )');
        }
      }
      lines.push('  ),');
    }
    if (i?.domain) {
      const doms = i.domain.domains ?? [];
      const interacts = i.domain.interactions ?? [];
      lines.push('  domain = DomainIntent(');
      if (doms.length) lines.push(`    domains = setOf(${doms.map((d) => `ProductDomain.${d}`).join(', ')}),`);
      if (interacts.length) lines.push(`    interactions = setOf(${interacts.map((it) => `InteractionPattern.${it}`).join(', ')}),`);
      lines.push('  ),');
    }
    lines.push(')');
    return lines.join('\n');
  }

  const scheduleInit = () => {
    if (typeof window !== 'undefined') {
      if ('requestIdleCallback' in window) window.requestIdleCallback(initStudio);
      else setTimeout(initStudio, 200);
    }
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleInit);
  } else {
    scheduleInit();
  }
</script>

<style>
  .studio-app {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background: var(--docs-bg);
  }

  .studio-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5rem;
    height: 56px;
    background: var(--docs-surface);
    border-bottom: 1px solid var(--docs-border);
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: var(--docs-shadow-sm);
  }

  .topbar-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--docs-text);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .brand-link:focus-visible {
    outline: 2px solid var(--docs-focus-ring);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .studio-badge {
    background: var(--docs-sidebar-active-bg);
    color: var(--docs-accent);
    border: 1px solid color-mix(in srgb, var(--docs-accent) 30%, transparent);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
  }

  .topbar-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .studio-btn {
    padding: 0.35rem 0.8rem;
    font-size: 0.8125rem;
    font-weight: 600;
    border-radius: 6px;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    border: 1px solid transparent;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease, transform 0.1s ease;
  }

  .btn-icon-text {
    gap: 0.375rem;
  }

  .studio-btn:hover {
    transform: translateY(-1px);
  }

  .studio-btn:active {
    transform: translateY(0);
  }

  .studio-btn:focus-visible {
    outline: 2px solid var(--docs-focus-ring);
    outline-offset: 2px;
  }

  /* Light mode buttons */
  :global([data-theme="light"]) .btn-primary {
    background: var(--docs-accent, #2563eb);
    color: #ffffff;
    box-shadow: 0 1px 3px rgba(37, 99, 235, 0.25);
  }

  :global([data-theme="light"]) .btn-primary:hover {
    background: var(--docs-link-hover, #1d4ed8);
    box-shadow: 0 2px 6px rgba(37, 99, 235, 0.35);
  }

  :global([data-theme="light"]) .btn-secondary {
    background: #ffffff;
    color: var(--docs-text, #1e293b);
    border-color: var(--docs-border, #e2e8f0);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  :global([data-theme="light"]) .btn-secondary:hover {
    background: var(--docs-surface-recessed, #f1f5f9);
    border-color: var(--docs-border-strong, #cbd5e1);
  }

  /* Dark mode buttons */
  :global([data-theme="dark"]) .btn-primary {
    background: var(--docs-accent, #2563eb);
    color: #ffffff;
    font-weight: 600;
    box-shadow: none;
    border: none;
  }

  :global([data-theme="dark"]) .btn-primary:hover {
    background: #1d4ed8;
    box-shadow: none;
  }

  :global([data-theme="dark"]) .btn-secondary {
    background: #141414;
    color: var(--docs-text, #f5f5f7);
    border-color: rgba(255, 255, 255, 0.14);
    box-shadow: none;
  }

  :global([data-theme="dark"]) .btn-secondary:hover {
    background: #1e1e1e;
    border-color: rgba(255, 255, 255, 0.25);
    box-shadow: none;
  }

  .btn-docs {
    background: transparent;
    color: var(--docs-text-muted);
  }

  .btn-docs:hover {
    color: var(--docs-text);
    background: var(--docs-card-hover);
  }

  /* Layout */
  .studio-main {
    flex: 1;
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 1.5rem;
    padding: 1.5rem;
    align-items: start;
    max-width: 1600px;
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
    position: relative;
  }

  /* Desktop Control Panel */
  .studio-controls-panel {
    background: var(--docs-surface);
    border: 1px solid var(--docs-border);
    border-radius: 10px;
    box-shadow: var(--docs-shadow-sm);
    max-height: calc(100vh - 90px);
    overflow-y: auto;
    position: sticky;
    top: 70px;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .sheet-header {
    display: none;
  }

  .sheet-content {
    padding: 1.25rem;
  }

  .controls-section {
    border-bottom: 1px solid var(--docs-border-subtle);
    padding-bottom: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .controls-section:last-child {
    border-bottom: none;
    padding-bottom: 0;
    margin-bottom: 0;
  }

  .section-heading {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--docs-text);
    margin: 0 0 0.875rem 0;
    letter-spacing: -0.01em;
  }

  .section-note {
    font-size: 0.75rem;
    color: var(--docs-text-muted);
    margin: -0.5rem 0 0.875rem 0;
    line-height: 1.4;
  }

  /* Viewport and Workspace */
  .studio-viewport {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .basis-preview-scope {
    --preview-bg: var(--b-color-surface-elevated, var(--docs-surface));
    --preview-border: var(--b-color-border-default, var(--docs-border));
    --preview-text: var(--b-color-content-default, var(--docs-text));
  }

  .studio-workspace {
    flex: 1;
    background: var(--docs-surface);
