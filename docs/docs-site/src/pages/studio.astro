---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import ReportDrawer from '../components/studio/ReportDrawer.astro';
import { loadIntentDoc } from '../lib/load-intent';
import { deriveControlSpecs } from '../lib/control-generator';
import ChoiceChips from '../components/controls/ChoiceChips.astro';
import KnobSlider from '../components/controls/KnobSlider.astro';
import ColorField from '../components/controls/ColorField.astro';
import ToggleControl from '../components/controls/ToggleControl.astro';
import ColorListField from '../components/controls/ColorListField.astro';
import {
  ButtonSpecimen,
  CardSpecimen,
  InputSpecimen,
  ChipsSpecimen,
  SwitchSpecimen,
  ListItemSpecimen,
  IllustrativeNote,
} from '../components/specimens';
import { resolveStudioDefaultCss } from '../lib/resolve-studio-default';

const intentDoc = loadIntentDoc();
const controlSpecs = deriveControlSpecs(intentDoc);
const defaultStudioCss = resolveStudioDefaultCss('#studio-preview');
---

<BaseLayout title="Intent Studio — Basis">
  <!-- Inlined deterministic tokens for instant SSR paint without JS -->
  <style id="studio-preview-default" set:html={defaultStudioCss.css} />

  <div class="studio-app" data-pagefind-body>
    <!-- Top bar: Full-bleed route without sidebar per locked decisions -->
    <header class="studio-topbar" aria-label="Studio top navigation">
      <div class="topbar-left">
        <a href="/" class="brand-link" aria-label="Basis Home">
          <svg class="brand-logo" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="4" stroke="var(--docs-accent, #58a6ff)" stroke-width="2" />
            <circle cx="12" cy="12" r="4" fill="var(--docs-accent, #58a6ff)" />
          </svg>
          <span class="brand-title">Basis</span>
        </a>
        <span class="studio-badge">Studio</span>
      </div>

      <div class="topbar-actions">
        <!-- Toggle Controls (panel on desktop, bottom sheet on mobile) -->
        <button
          type="button"
          id="studio-toggle-controls"
          class="studio-btn btn-secondary btn-icon-text"
          aria-label="Toggle controls panel"
          aria-controls="studio-controls-panel"
          aria-expanded="false"
          title="Toggle controls (Alt+C)"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="4" y1="21" x2="4" y2="14" />
            <line x1="4" y1="10" x2="4" y2="3" />
            <line x1="12" y1="21" x2="12" y2="12" />
            <line x1="12" y1="8" x2="12" y2="3" />
            <line x1="20" y1="21" x2="20" y2="16" />
            <line x1="20" y1="12" x2="20" y2="3" />
            <line x1="1" y1="14" x2="7" y2="14" />
            <line x1="9" y1="8" x2="15" y2="8" />
            <line x1="17" y1="16" x2="23" y2="16" />
          </svg>
          <span>Controls</span>
        </button>

        <!-- Toggle Report Drawer -->
        <button
          type="button"
          id="studio-toggle-report"
          class="studio-btn btn-secondary btn-icon-text"
          aria-label="Toggle resolution report drawer"
          aria-controls="studio-report-drawer"
          aria-expanded="false"
          title="Toggle report drawer (Alt+R)"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
            <line x1="16" y1="13" x2="8" y2="13" />
            <line x1="16" y1="17" x2="8" y2="17" />
            <polyline points="10 9 9 9 8 9" />
          </svg>
          <span>Report</span>
        </button>

        <ThemeToggle />

        <button type="button" id="studio-reset-btn" class="studio-btn btn-secondary" aria-label="Reset theme settings">
          Reset
        </button>
        <button type="button" id="studio-copy-kotlin-btn" class="studio-btn btn-secondary" aria-label="Copy Kotlin code to clipboard">
          Copy Kotlin
        </button>
        <button type="button" id="studio-share-btn" class="studio-btn btn-primary" aria-label="Share current theme configuration">
          Share
        </button>
        <a href="/docs/getting-started/overview" class="studio-btn btn-docs" aria-label="Go to documentation">
          Docs
        </a>
      </div>
    </header>

    <!-- Mobile Bottom Sheet Backdrop -->
    <div id="controls-sheet-backdrop" class="sheet-backdrop" aria-hidden="true"></div>

    <main id="studio-main" class="studio-main">
      <!-- Control Generator Panel: Controls derived from Intent schema & vocabulary -->
      <!-- On narrow screens (< 900px), becomes a bottom sheet -->
      <aside
        id="studio-controls-panel"
        class="studio-controls-panel"
        aria-label="Theme Intent Controls"
        data-open="false"
      >
        <div class="sheet-header">
          <div class="sheet-drag-handle" aria-hidden="true">
            <div class="drag-bar"></div>
          </div>
          <div class="sheet-title-bar">
            <h2 class="sheet-title">Theme Intent Controls</h2>
            <button
              type="button"
              id="controls-close-btn"
              class="sheet-close-btn"
              aria-label="Close controls panel"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M18 6L6 18M6 6l12 12" />
              </svg>
            </button>
          </div>
        </div>

        <div class="sheet-content">
          <div class="controls-section">
            <h2 class="section-heading">Identity</h2>
            <ColorField spec={controlSpecs.identity.brandColor} />
            <ChoiceChips spec={controlSpecs.identity.presence} />
            <ToggleControl spec={controlSpecs.identity.deriveColors} />
            <ColorListField spec={controlSpecs.identity.supportingColors} />
          </div>

          <div class="controls-section">
            <h2 class="section-heading">Mood Preset</h2>
            <ChoiceChips spec={controlSpecs.mood.preset} />
          </div>

          <div class="controls-section">
            <h2 class="section-heading">Mood Knobs</h2>
            <p class="section-note">Sparse biases over preset. Unset knobs inherit the preset profile.</p>
            {controlSpecs.mood.knobs.map((knob) => (
              <KnobSlider spec={knob} />
            ))}
          </div>

          <div class="controls-section">
            <h2 class="section-heading">Domain & Context</h2>
            <ChoiceChips spec={controlSpecs.domain.domains} />
            <ChoiceChips spec={controlSpecs.domain.interactions} />
          </div>
        </div>
      </aside>

      <!-- Scene Viewport: Housing the live preview workspace (P2.6 Generic Scene) -->
      <section id="studio-viewport" class="studio-viewport" aria-label="Scene Preview Viewport">
        <!-- Localized Studio Preview Scope: uses deferred local --b-* intent resolution -->
        <div class="studio-workspace basis-preview-scope" id="studio-preview" data-scope="preview">
          <div class="scene-container">
            <!-- Scene Header Bar -->
            <header class="scene-header">
              <div class="scene-header-title-box">
                <div class="scene-logo-badge" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <rect x="2" y="2" width="20" height="20" rx="5" />
                    <path d="M7 17L17 7M17 7H10M17 7V14" />
                  </svg>
                </div>
                <div>
                  <h2 class="scene-title">Design Console</h2>
                  <p class="scene-subtitle">Live specimen composition reacting dynamically to resolved Basis design tokens.</p>
                </div>
              </div>

              <div class="scene-header-actions">
                <ChipsSpecimen label="Real-time Sync" selected={true} />
                <ChipsSpecimen label="WCAG AA" />
                <SwitchSpecimen label="Auto-Resolve" checked={true} id="studio-scene-sync" />
              </div>
            </header>

            <!-- Specimen Layout Grid (2 Columns) -->
            <div class="scene-grid">
              <!-- Left Column: Metrics & Form Controls -->
              <div class="scene-column">
                <!-- Elevated Metric Card -->
                <CardSpecimen variant="elevated" class="scene-card">
                  <div slot="header" class="card-header-flex">
                    <div>
                      <span class="card-kicker">Performance Targets</span>
                      <h3 class="card-title-text">Luminance & Contrast Verification</h3>
                    </div>
                    <ButtonSpecimen variant="secondary" size="sm">Export Report</ButtonSpecimen>
                  </div>

                  <div class="scene-metrics-strip">
                    <div class="scene-metric-cell">
                      <span class="scene-metric-number">19.5<small class="scene-unit">ms</small></span>
                      <span class="scene-metric-caption">Resolution Latency</span>
                    </div>
                    <div class="scene-metric-divider" aria-hidden="true"></div>
                    <div class="scene-metric-cell">
                      <span class="scene-metric-number">4.5<small class="scene-unit">:1</small></span>
                      <span class="scene-metric-caption">WCAG AA Floor</span>
                    </div>
                    <div class="scene-metric-divider" aria-hidden="true"></div>
                    <div class="scene-metric-cell">
                      <span class="scene-metric-number">157</span>
                      <span class="scene-metric-caption">Resolved Tokens</span>
                    </div>
                  </div>

                  <div slot="footer" class="card-footer-flex">
                    <ChipsSpecimen label="OKLCH Color" selected={true} />
                    <ChipsSpecimen label="Tonal Dark Mode" selected={true} />
                    <ChipsSpecimen label="Deterministic" selected={true} />
                  </div>
                </CardSpecimen>

                <!-- Outlined Input Form Card -->
                <CardSpecimen variant="outlined" class="scene-card">
                  <div slot="header" class="card-header-flex">
                    <div>
                      <span class="card-kicker">Interactive Input Form</span>
                      <h3 class="card-title-text">Data & Search Specifications</h3>
                    </div>
                  </div>

                  <div class="scene-form-group">
                    <InputSpecimen
                      id="scene-input-org"
                      label="Organization Identifier"
                      value="Basis Jetpack Compose Core"
                      helperText="Resolves against Basis single source of truth."
                    />
                    <InputSpecimen
                      id="scene-input-search"
                      label="Catalog Search Query"
                      placeholder="e.g. basisSurface, primaryButton..."
                    />
                    <div class="scene-buttons-row">
                      <ButtonSpecimen variant="primary" size="md">Save Changes</ButtonSpecimen>
                      <ButtonSpecimen variant="secondary" size="md">Discard</ButtonSpecimen>
                      <ButtonSpecimen variant="secondary" size="md" disabled={true}>Read-only</ButtonSpecimen>
                    </div>
                  </div>
                </CardSpecimen>
              </div>

              <!-- Right Column: Navigation & List Items -->
              <div class="scene-column">
                <!-- Default Surface List Items Card -->
                <CardSpecimen variant="default" class="scene-card">
                  <div slot="header" class="card-header-flex">
                    <div>
                      <span class="card-kicker">Pipeline Stages</span>
                      <h3 class="card-title-text">Active Theme Pipeline</h3>
                    </div>
                    <span class="scene-badge-pill">4 Active</span>
                  </div>

                  <div class="scene-list-stack">
                    <ListItemSpecimen
                      headline="Identity & Brand Presence"
                      supportingText="OKLCH uniform chroma derivation"
                      trailingMeta="Resolved"
                      interactive={true}
                      selected={true}
                    />
                    <ListItemSpecimen
                      headline="Mood Presets & Sparse Knobs"
                      supportingText="Deterministic bias over archetypes"
                      trailingMeta="Honored"
                      interactive={true}
                    />
                    <ListItemSpecimen
                      headline="Domain & Interaction Intent"
                      supportingText="Functional density & typographic scale"
                      trailingMeta="Active"
                      interactive={true}
                    />
                    <ListItemSpecimen
                      headline="Legacy Exemption Pipeline"
                      supportingText="Deprecated fallback profile"
                      trailingMeta="Unset"
                      disabled={true}
                      interactive={true}
                    />
                  </div>

                  <div slot="footer" class="scene-footer-note">
                    <IllustrativeNote />
                  </div>
                </CardSpecimen>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Report Drawer: Slide-over inspection drawer -->
      <ReportDrawer />
    </main>
  </div>
</BaseLayout>

<script type="module">
  // Live Studio intent store: controls -> debounced resolve -> --b-* preview scope + report.
  import {
    createStudioIntentStore,
    bindControlEvents,
    loadDocsRuntime,
    buildKotlinFromIntent,
    encodeIntentHash,
    decodeIntentHash,
  } from '../lib/studio-intent';

  function applyTokensToScope(el, result) {
    if (!result?.ok || !result.tokens) return;
    const theme = document.documentElement.getAttribute('data-theme') || 'dark';
    const map = theme === 'dark' ? result.tokens.dark : result.tokens.light;
    for (const [key, value] of Object.entries(map)) {
      el.style.setProperty(key, value);
    }
  }

  function syncControlsFromIntent(panelEl, intent) {
    if (!panelEl || !intent) return;

    // 1. Brand Color
    const brandColorField = panelEl.querySelector('#color-brandColor');
    if (brandColorField) {
      const hex = intent.identity?.brandColor?.value || '';
      const textInput = brandColorField.querySelector('.hex-text-input');
      const nativeInput = brandColorField.querySelector('.native-color-input');
      const swatch = brandColorField.querySelector('.color-swatch-preview');
      const clearBtn = brandColorField.querySelector('.color-clear-btn');
      if (textInput) textInput.value = hex ? hex.replace('#', '') : '';
      if (nativeInput) nativeInput.value = hex || '#58a6ff';
      if (swatch) swatch.style.backgroundColor = hex || '#58a6ff';
      if (clearBtn) clearBtn.disabled = !hex;
      if (hex) brandColorField.classList.remove('is-empty');
      else brandColorField.classList.add('is-empty');
    }

    // 2. Presence
    const presenceField = panelEl.querySelector('[data-field-id="presence"]');
    if (presenceField) {
      const presenceVal = intent.identity?.presence || null;
      const chips = presenceField.querySelectorAll('.choice-chip');
      chips.forEach((chip) => {
        const match = chip.dataset.value === presenceVal;
        chip.setAttribute('aria-checked', match ? 'true' : 'false');
        if (match) chip.classList.add('is-active');
        else chip.classList.remove('is-active');
      });
    }

    // 3. Derive Colors
    const deriveField = panelEl.querySelector('[data-field-id="deriveColors"]');
    if (deriveField) {
      const deriveVal = intent.identity?.deriveColors !== false; // default true
      const switchBtn = deriveField.querySelector('.toggle-switch');
      if (switchBtn) {
        switchBtn.setAttribute('aria-checked', deriveVal ? 'true' : 'false');
        if (deriveVal) switchBtn.classList.add('is-checked');
        else switchBtn.classList.remove('is-checked');
      }
    }

    // 4. Mood Preset
    const presetField = panelEl.querySelector('[data-field-id="preset"]');
    if (presetField) {
      const presetVal = intent.mood?.preset || null;
      const chips = presetField.querySelectorAll('.choice-chip');
      chips.forEach((chip) => {
        const match = chip.dataset.value === presetVal;
        chip.setAttribute('aria-checked', match ? 'true' : 'false');
        if (match) chip.classList.add('is-active');
        else chip.classList.remove('is-active');
      });
    }

    // 5. Mood Knobs
    const knobs = intent.mood?.knobs || {};
    const knobFields = panelEl.querySelectorAll('.knob-slider-field');
    knobFields.forEach((knobField) => {
      const knobId = knobField.dataset.knobId;
      if (!knobId) return;
      const val = knobs[knobId];
      const isUnset = val === null || val === undefined;
      const num = isUnset ? 0.0 : Number(val);
      const rangeInput = knobField.querySelector('.knob-range-input');
      const readout = knobField.querySelector('.knob-value-readout');
      const inheritBtn = knobField.querySelector('.knob-inherit-btn');

      knobField.setAttribute('data-is-unset', isUnset ? 'true' : 'false');
      if (isUnset) knobField.classList.add('is-unset');
      else knobField.classList.remove('is-unset');

      if (rangeInput) rangeInput.value = String(num);
      if (readout) {
        readout.textContent = isUnset ? 'Inherit' : (num >= 0 ? `+${num.toFixed(2)}` : num.toFixed(2));
      }
      if (inheritBtn) {
        inheritBtn.disabled = isUnset;
        inheritBtn.setAttribute('aria-pressed', isUnset ? 'true' : 'false');
        if (isUnset) inheritBtn.classList.add('is-active');
        else inheritBtn.classList.remove('is-active');
      }
    });

    // 6. Domains & Interactions
    const domainsField = panelEl.querySelector('[data-field-id="domains"]');
    if (domainsField) {
      const doms = new Set(intent.domain?.domains || []);
      const chips = domainsField.querySelectorAll('.choice-chip');
      chips.forEach((chip) => {
        const match = doms.has(chip.dataset.value);
        chip.setAttribute('aria-checked', match ? 'true' : 'false');
        if (match) chip.classList.add('is-active');
        else chip.classList.remove('is-active');
      });
    }

    const interactionsField = panelEl.querySelector('[data-field-id="interactions"]');
    if (interactionsField) {
      const interacts = new Set(intent.domain?.interactions || []);
      const chips = interactionsField.querySelectorAll('.choice-chip');
      chips.forEach((chip) => {
        const match = interacts.has(chip.dataset.value);
        chip.setAttribute('aria-checked', match ? 'true' : 'false');
        if (match) chip.classList.add('is-active');
        else chip.classList.remove('is-active');
      });
    }
  }

  function updateReportDrawer(result, store) {
    const statusBadge = document.getElementById('report-status-badge');
    const violationsCount = document.getElementById('report-violations-count');
    const violationsContainer = document.getElementById('report-violations-container');
    const tokensVal = document.getElementById('report-meta-tokens-count');
    const modesVal = document.getElementById('report-meta-modes');
    const presetVal = document.getElementById('report-meta-preset');
    const domainContributions = document.getElementById('report-domain-contributions');
    const entriesCount = document.getElementById('report-entries-count');
    const entriesContainer = document.getElementById('report-entries-container');

    if (presetVal) {
      presetVal.textContent = store?.intent?.mood?.preset || 'None (Default)';
    }

    // Render domain & interaction biases
    if (domainContributions) {
      const domains = store?.intent?.domain?.domains || [];
      const interactions = store?.intent?.domain?.interactions || [];
      if (domains.length === 0 && interactions.length === 0) {
        domainContributions.innerHTML = `<p class="contributions-empty">No active domains or interaction patterns selected.</p>`;
      } else {
        const domCards = domains.map(
          (d) => `
          <div class="contribution-card">
            <div class="contribution-card-header">
              <span class="contribution-name">${d}</span>
              <span class="contribution-kind">Domain</span>
            </div>
          </div>
        `
        );
        const intCards = interactions.map(
          (it) => `
          <div class="contribution-card">
            <div class="contribution-card-header">
              <span class="contribution-name">${it}</span>
              <span class="contribution-kind">Interaction</span>
            </div>
          </div>
        `
        );
        domainContributions.innerHTML = [...domCards, ...intCards].join('');
      }
    }

    if (!result) return;

    if (result.ok) {
      if (statusBadge) {
        statusBadge.className = 'report-status-badge status-valid';
        statusBadge.textContent = 'Valid';
      }
      if (violationsCount) violationsCount.textContent = '0';
      if (violationsContainer) {
        violationsContainer.innerHTML = `
          <div class="violations-empty">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="empty-icon" aria-hidden="true">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
              <polyline points="22 4 12 14.01 9 11.01" />
            </svg>
            <p>No violations detected. Intent conforms to design system contracts.</p>
          </div>
        `;
      }
      if (tokensVal && result.tokens?.light) {
        tokensVal.textContent = String(Object.keys(result.tokens.light).length);
      }
      if (modesVal && result.report?.modes) {
        modesVal.textContent = Array.isArray(result.report.modes) ? result.report.modes.join(', ') : 'Light, Dark';
      }

      // Populate audit entries
      const entries = result.report?.entries || [];
      if (entriesCount) entriesCount.textContent = String(entries.length);
      if (entriesContainer) {
        if (entries.length === 0) {
          entriesContainer.innerHTML = `<p class="contributions-empty">No audit entries emitted for this resolution.</p>`;
        } else {
          entriesContainer.innerHTML = entries
            .map(
              (entry) => `
            <div class="audit-entry">
              <div class="audit-entry-header">
                <span class="audit-path">${entry.path}</span>
                <span class="audit-status status-${entry.status}">${entry.status}</span>
              </div>
              <div class="audit-msg">${entry.message}</div>
            </div>
          `
            )
            .join('');
        }
      }
    } else {
      const count = result.violations?.length || 0;
      if (statusBadge) {
        statusBadge.className = 'report-status-badge status-violations';
        statusBadge.textContent = `${count} Violation${count > 1 ? 's' : ''}`;
      }
      if (violationsCount) violationsCount.textContent = String(count);
      if (violationsContainer) {
        violationsContainer.innerHTML = (result.violations || [])
          .map(
            (v) => `
            <div class="violation-item" role="alert" style="padding: 0.625rem 0.75rem; background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.25); border-radius: 6px; font-size: 0.8125rem;">
              <div style="font-weight: 600; color: #ef4444; font-size: 0.75rem; font-family: monospace;">[${v.path}]</div>
              <div style="color: var(--docs-text); margin-top: 0.25rem;">${v.message}</div>
            </div>
          `
          )
          .join('');
      }
    }
  }

  function initStudio() {
    const panelEl = document.getElementById('studio-controls-panel');
    const previewEl = document.getElementById('studio-preview');
    const reportDrawerEl = document.getElementById('studio-report-drawer');
    const toggleControlsBtn = document.getElementById('studio-toggle-controls');
    const toggleReportBtn = document.getElementById('studio-toggle-report');
    const controlsCloseBtn = document.getElementById('controls-close-btn');
    const reportCloseBtn = document.getElementById('report-close-btn');
    const controlsBackdrop = document.getElementById('controls-sheet-backdrop');
    const reportBackdrop = document.getElementById('report-drawer-backdrop');
    const copyReportJsonBtn = document.getElementById('report-copy-json-btn');

    if (!panelEl || !previewEl) return;

    const isNarrow = () => window.matchMedia('(max-width: 900px)').matches;

    // Controls panel / bottom sheet toggling
    function setControlsOpen(open) {
      panelEl.setAttribute('data-open', open ? 'true' : 'false');
      toggleControlsBtn?.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (isNarrow()) {
        panelEl.setAttribute('aria-hidden', open ? 'false' : 'true');
        if (controlsBackdrop) {
          if (open) controlsBackdrop.classList.add('is-active');
          else controlsBackdrop.classList.remove('is-active');
        }
      } else {
        panelEl.setAttribute('aria-hidden', 'false');
      }
      if (open && isNarrow()) {
        panelEl.focus();
      }
    }

    // Report drawer toggling
    function setReportOpen(open) {
      if (!reportDrawerEl) return;
      reportDrawerEl.setAttribute('data-open', open ? 'true' : 'false');
      reportDrawerEl.setAttribute('aria-hidden', open ? 'false' : 'true');
      toggleReportBtn?.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (reportBackdrop) {
        if (open) reportBackdrop.classList.add('is-active');
        else reportBackdrop.classList.remove('is-active');
      }
      if (open) {
        reportDrawerEl.focus();
      }
    }

    toggleControlsBtn?.addEventListener('click', () => {
      const current = panelEl.getAttribute('data-open') === 'true';
      setControlsOpen(!current);
    });

    controlsCloseBtn?.addEventListener('click', () => {
      setControlsOpen(false);
      toggleControlsBtn?.focus();
    });

    controlsBackdrop?.addEventListener('click', () => {
      setControlsOpen(false);
      toggleControlsBtn?.focus();
    });

    toggleReportBtn?.addEventListener('click', () => {
      const current = reportDrawerEl?.getAttribute('data-open') === 'true';
      setReportOpen(!current);
    });

    reportCloseBtn?.addEventListener('click', () => {
      setReportOpen(false);
      toggleReportBtn?.focus();
    });

    reportBackdrop?.addEventListener('click', () => {
      setReportOpen(false);
      toggleReportBtn?.focus();
    });

    // Keyboard Shortcuts: Alt+C, Alt+R, Escape
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (reportDrawerEl?.getAttribute('data-open') === 'true') {
          setReportOpen(false);
          toggleReportBtn?.focus();
          e.preventDefault();
          return;
        }
        if (panelEl.getAttribute('data-open') === 'true' && isNarrow()) {
          setControlsOpen(false);
          toggleControlsBtn?.focus();
          e.preventDefault();
          return;
        }
      }

      if (e.altKey && (e.key === 'c' || e.key === 'C')) {
        e.preventDefault();
        const current = panelEl.getAttribute('data-open') === 'true';
        setControlsOpen(!current);
        return;
      }

      if (e.altKey && (e.key === 'r' || e.key === 'R')) {
        e.preventDefault();
        const current = reportDrawerEl?.getAttribute('data-open') === 'true';
        setReportOpen(!current);
        return;
      }
    });

    // Initial state from URL hash if present
    let initialIntent = null;
    if (window.location.hash) {
      initialIntent = decodeIntentHash(window.location.hash);
    }

    // Create studio intent store
    const setState = () => {};
    const store = createStudioIntentStore(setState, undefined, initialIntent);

    // If loaded from valid hash, synchronize DOM controls
    if (initialIntent) {
      syncControlsFromIntent(panelEl, initialIntent);
    }

    // Bind controls
    const unbind = bindControlEvents(panelEl, store);

    const observe = () => {
      applyTokensToScope(previewEl, store.lastGood ?? store.current ?? null);
      updateReportDrawer(store.current, store);
      // Persist URL state via hash
      const hash = encodeIntentHash(store.intent);
      if (window.location.hash !== hash) {
        history.replaceState(null, '', hash);
      }
    };

    panelEl.addEventListener('control-change', () => {
      observe();
    });

    // Watch for theme mode changes (Light/Dark) to refresh preview scope
    const themeObserver = new MutationObserver(() => {
      applyTokensToScope(previewEl, store.lastGood ?? store.current ?? null);
    });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    // Top bar actions
    const resetBtn = document.getElementById('studio-reset-btn');
    const copyBtn = document.getElementById('studio-copy-kotlin-btn');
    const shareBtn = document.getElementById('studio-share-btn');

    resetBtn?.addEventListener('click', () => {
      store.reset();
      previewEl.style.cssText = '';
      history.replaceState(null, '', window.location.pathname);
      syncControlsFromIntent(panelEl, store.intent);
      observe();
    });

    copyBtn?.addEventListener('click', async () => {
      const intent = store.intent;
      const kotlin = buildKotlinFromIntent(intent);
      try {
        await navigator.clipboard.writeText(kotlin);
        copyBtn.textContent = 'Copied!';
      } catch {
        copyBtn.textContent = 'Copied!';
      }
      setTimeout(() => {
        copyBtn.textContent = 'Copy Kotlin';
      }, 2000);
    });

    shareBtn?.addEventListener('click', async () => {
      const hash = encodeIntentHash(store.intent);
      const url = `${window.location.origin}${window.location.pathname}${hash}`;
      try {
        await navigator.clipboard.writeText(url);
        shareBtn.textContent = 'Link copied!';
      } catch {
        shareBtn.textContent = 'Link copied!';
      }
      setTimeout(() => {
        shareBtn.textContent = 'Share';
      }, 2000);
    });

    copyReportJsonBtn?.addEventListener('click', async () => {
      const payload = store.current ? JSON.stringify(store.current, null, 2) : JSON.stringify(store.intent, null, 2);
      await navigator.clipboard.writeText(payload);
      copyReportJsonBtn.textContent = 'Copied!';
      setTimeout(() => {
        copyReportJsonBtn.innerHTML = `
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
          </svg>
          <span>Copy JSON</span>
        `;
      }, 2000);
    });

    // Initial resolve
    void loadDocsRuntime()
      .then(() => observe())
      .catch(() => {
        /* last-good fallback */
      });

    return () => {
      unbind();
      themeObserver.disconnect();
    };
  }

  const scheduleInit = () => {
    if (typeof window !== 'undefined') {
      if ('requestIdleCallback' in window) window.requestIdleCallback(initStudio);
      else setTimeout(initStudio, 200);
    }
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleInit);
  } else {
    scheduleInit();
  }
</script>

