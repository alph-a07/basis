---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Intent Studio — Basis">
  <div style="padding: 2rem; max-width: 1200px; margin: 0 auto;" data-pagefind-body>
    <header style="margin-bottom: 2rem;">
      <h1 style="font-size: 2.5rem; margin-bottom: 0.5rem;">Intent Studio</h1>
      <p style="color: #8b949e; font-size: 1.1rem; margin: 0;">
        Interactive design-system workbench driven by the Basis intent resolution engine.
      </p>
    </header>

    <div style="background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 3rem; text-align: center;">
      <p style="color: #c9d1d9; font-size: 1.2rem;">Studio Workspace Shell (Phase 2)</p>
    </div>
  </div>
</BaseLayout>
