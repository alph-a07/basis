---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { loadIntentDoc } from '../lib/load-intent';
import { deriveControlSpecs } from '../lib/control-generator';
import ChoiceChips from '../components/controls/ChoiceChips.astro';
import KnobSlider from '../components/controls/KnobSlider.astro';
import ColorField from '../components/controls/ColorField.astro';
import ToggleControl from '../components/controls/ToggleControl.astro';
import ColorListField from '../components/controls/ColorListField.astro';

const intentDoc = loadIntentDoc();
const controlSpecs = deriveControlSpecs(intentDoc);
---

<BaseLayout title="Intent Studio — Basis">
  <div class="studio-app" data-pagefind-body>
    <!-- Top bar: Full-bleed route without sidebar per locked decisions -->
    <header class="studio-topbar" aria-label="Studio top navigation">
      <div class="topbar-left">
        <a href="/" class="brand-link" aria-label="Basis Home">
          <svg class="brand-logo" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="4" stroke="var(--docs-accent, #58a6ff)" stroke-width="2" />
            <circle cx="12" cy="12" r="4" fill="var(--docs-accent, #58a6ff)" />
          </svg>
          <span class="brand-title">Basis</span>
        </a>
        <span class="studio-badge">Studio</span>
      </div>

      <div class="topbar-actions">
        <ThemeToggle />
        <button type="button" class="studio-btn btn-secondary" aria-label="Reset theme settings">
          Reset
        </button>
        <button type="button" class="studio-btn btn-secondary" aria-label="Copy Kotlin code to clipboard">
          Copy Kotlin
        </button>
        <button type="button" class="studio-btn btn-primary" aria-label="Share current theme configuration">
          Share
        </button>
        <a href="/docs/getting-started/overview" class="studio-btn btn-docs" aria-label="Go to documentation">
          Docs
        </a>
      </div>
    </header>

    <main id="studio-main" class="studio-main">
      <!-- Control Generator Panel: Controls derived from Intent schema & vocabulary -->
      <aside class="studio-controls-panel" aria-label="Theme Intent Controls">
        <div class="controls-section">
          <h2 class="section-heading">Identity</h2>
          <ColorField spec={controlSpecs.identity.brandColor} />
          <ChoiceChips spec={controlSpecs.identity.presence} />
          <ToggleControl spec={controlSpecs.identity.deriveColors} />
          <ColorListField spec={controlSpecs.identity.supportingColors} />
        </div>

        <div class="controls-section">
          <h2 class="section-heading">Mood Preset</h2>
          <ChoiceChips spec={controlSpecs.mood.preset} />
        </div>

        <div class="controls-section">
          <h2 class="section-heading">Mood Knobs</h2>
          <p class="section-note">Sparse biases over preset. Unset knobs inherit the preset profile.</p>
          {controlSpecs.mood.knobs.map((knob) => (
            <KnobSlider spec={knob} />
          ))}
        </div>

        <div class="controls-section">
          <h2 class="section-heading">Domain & Context</h2>
          <ChoiceChips spec={controlSpecs.domain.domains} />
          <ChoiceChips spec={controlSpecs.domain.interactions} />
        </div>
      </aside>

      <!-- Localized Studio Preview Scope: uses deferred local --b-* intent resolution -->
      <div class="studio-workspace basis-preview-scope" id="studio-preview" data-scope="preview">
        <div class="studio-placeholder">
          <h1>Intent Studio Shell</h1>
          <p>Full-bleed workspace for live intent exploration and real-time Kotlin token export.</p>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>

---
import { createStudioIntentStore, bindControlEvents, loadDocsRuntime, type ResolveResult } from '../lib/studio-intent';
---
<script type="module">
  // Live Studio intent store: controls -> debounced resolve -> --b-* preview scope + report.
  // Replaced the previous deferred preview-theme stub (which never loaded docs-runtime).
  import { createStudioIntentStore, bindControlEvents, loadDocsRuntime } from '../lib/studio-intent';

  function applyTokensToScope(el: HTMLElement, result: { ok: boolean; tokens?: { light: Record<string, string>; dark: Record<string, string>; css?: string } }) {
    if (!result.ok || !result.tokens) return;
    const theme = document.documentElement.getAttribute('data-theme') || 'dark';
    const map = theme === 'dark' ? result.tokens.dark : result.tokens.light;
    for (const [key, value] of Object.entries(map)) {
      el.style.setProperty(key, value);
    }
  }

  function showViolations(result: ResolveResult | null) {
    let banner = document.getElementById('studio-violation-banner');
    if (result?.ok) {
      if (banner) banner.remove();
      return;
    }
    const violations = result?.ok === false ? result.violations : [];
    if (!banner) {
      banner = document.createElement('div');
      banner.id = 'studio-violation-banner';
      banner.className = 'violation-banner';
      banner.setAttribute('role', 'alert');
      banner.setAttribute('aria-live', 'polite');
      banner.style.cssText = 'position:sticky;top:56px;z-index:49;display:none;';
      document.querySelector('.studio-app')?.appendChild(banner);
    }
    if (violations.length === 0) {
      banner.style.display = 'none';
      return;
    }
    banner.style.display = 'block';
    banner.style.background = 'color-mix(in srgb, var(--docs-accent) 12%, transparent)';
    banner.innerHTML =
      '<div style="max-width:1280px;margin:0 auto;padding:0.75rem 1.5rem;color:var(--docs-text);font-size:0.875rem">' +
      '<strong>Theme warnings:</strong><ul style="margin:.25rem 0 0 1rem;padding:0">' +
      violations.map((v) => `<li>[${v.path}] ${v.message}</li>`).join('') +
      '</ul>' +
      '<button id="banner-dismiss" style="margin-left:auto;background:none;border:none;color:inherit;cursor:pointer">Dismiss</button>' +
      '</div>';
    banner.querySelector('#banner-dismiss')?.addEventListener('click', () => { banner.style.display = 'none'; });
  }

  function initStudio() {
    const panelEl = document.querySelector('.studio-controls-panel') as HTMLElement | null;
    const previewEl = document.getElementById('studio-preview');
    if (!panelEl || !previewEl) return;

    const setState = (fn: (s: { intent: unknown; lastGood: unknown; current: unknown }) => void) => {
      // no-op: the store calls this on every mutation; we use current/lastGood locally instead
      void fn;
    };

    const store = createStudioIntentStore(setState);

    // Bind all control-change events into the store.
    const unbind = bindControlEvents(panelEl, store);

    // On each debounced resolve, apply tokens to the preview scope and surface violations.
    // The store calls its setState setter; we read store.current / store.lastGood after each.
    const originalSetState = setState as any;
    const observe = (fn: (s: { intent: unknown; lastGood: unknown; current: unknown }) => void) => {
      fn({ intent: store.intent, lastGood: store.lastGood, current: store.current });
      applyTokensToScope(previewEl as HTMLElement, store.lastGood ?? store.current ?? null);
      showViolations(store.current);
    };
    // Re-wire: replace setState behaviour by re-observing on mutation via a polling-free approach
    // The store's resolveDebounced sets current/lastGood; we hook by wrapping scheduleResolve output.
    let pending = false;
    const schedule = (store as any);
    // Simpler: poll-free via a micro-observer by re-calling observe on each control-change that resolves.
    const handler = () => {
      observe(() => {});
    };
    panelEl.addEventListener('control-change', handler);

    // Top bar button wiring:
    const resetBtn = document.querySelector('[aria-label="Reset theme settings"]') as HTMLButtonElement | null;
    const copyBtn = document.querySelector('[aria-label="Copy Kotlin code to clipboard"]') as HTMLButtonElement | null;
    const shareBtn = document.querySelector('[aria-label="Share current theme configuration"]') as HTMLButtonElement | null;

    resetBtn?.addEventListener('click', () => {
      store.reset();
      (previewEl as HTMLElement).style.cssText = '';
      observe(() => {});
    });

    copyBtn?.addEventListener('click', async () => {
      if (!store.current?.ok) return;
      // Emit a minimal Kotlin source snippet from the active intent.
      const intent = store.intent;
      const kotlin = buildKotlinFromIntent(intent);
      await navigator.clipboard.writeText(kotlin);
      copyBtn.textContent = 'Copied!';
      setTimeout(() => { copyBtn.textContent = 'Copy Kotlin'; }, 2000);
    });

    shareBtn?.addEventListener('click', () => {
      const json = JSON.stringify(store.intent, null, 0);
      const encoded = btoa(json);
      const url = `${window.location.origin}${window.location.pathname}#v1.${encoded}`;
      navigator.clipboard.writeText(url).then(() => {
        shareBtn.textContent = 'Link copied!';
        setTimeout(() => { shareBtn.textContent = 'Share'; }, 2000);
      });
    });

    // Initial resolve.
    void loadDocsRuntime().then(() => observe(() => {})).catch(() => { /* last-good fallback */ });

    return () => {
      unbind();
      panelEl.removeEventListener('control-change', handler);
    };
  }

  function buildKotlinFromIntent(intent: unknown): string {
    // Minimal Kotlin emission mirroring BasisIntent structure. (P2.8 refines; this is the v1 surface.)
    const i = intent as any;
    const lines: string[] = [];
    lines.push('BasisIntent(');
    if (i.identity) {
      lines.push('  identity = IdentityIntent(');
      if (i.identity.brandColor) lines.push(`    brandColor = ColorSpec.Hex("${i.identity.brandColor.value}"),`);
      if (i.identity.presence) lines.push(`    presence = BrandPresence.${i.identity.presence},`);
      lines.push(`    deriveColors = ${i.identity.deriveColors ?? true}`);
      lines.push('  ),');
    }
    if (i.mood && (i.mood.preset || (i.mood.knobs && Object.keys(i.mood.knobs).length))) {
      lines.push('  mood = MoodIntent(');
      if (i.mood.preset) lines.push(`    preset = MoodPreset.${i.mood.preset},`);
      if (i.mood.knobs) {
        const knobLines = Object.entries(i.mood.knobs)
          .filter(([, v]) => v !== null && v !== undefined)
          .map(([k, v]) => `      ${k} = ${v}f,`);
        if (knobLines.length) {
          lines.push('    knobs = MoodKnobs(');
          lines.push(...knobLines);
          lines.push('    )');
        }
      }
      lines.push('  ),');
    }
    if (i.domain) {
      const doms = i.domain.domains ?? [];
      const interacts = i.domain.interactions ?? [];
      lines.push('  domain = DomainIntent(');
      if (doms.length) lines.push(`    domains = setOf(${doms.map((d: string) => `ProductDomain.${d}`).join(', ')}),`);
      if (interacts.length) lines.push(`    interactions = setOf(${interacts.map((it: string) => `InteractionPattern.${it}`).join(', ')}),`);
      lines.push('  ),');
    }
    lines.push(')');
    return lines.join('\n');
  }

  // Mount on idle to avoid blocking first paint.
  const scheduleInit = (): void => {
    if (typeof window !== 'undefined') {
      if ('requestIdleCallback' in window) window.requestIdleCallback(initStudio);
      else setTimeout(initStudio, 200);
    }
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleInit);
  } else {
    scheduleInit();
  }
</script>

<style>
  .violation-banner {
    border-bottom: 1px solid var(--docs-border);
  }
</style>

<style>
  .studio-app {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .studio-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5rem;
    height: 56px;
    background: var(--docs-surface);
    border-bottom: 1px solid var(--docs-border);
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: var(--docs-shadow-sm);
  }

  .topbar-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--docs-text);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .brand-link:focus-visible {
    outline: 2px solid var(--docs-focus-ring);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .studio-badge {
    background: var(--docs-sidebar-active-bg);
    color: var(--docs-accent);
    border: 1px solid color-mix(in srgb, var(--docs-accent) 30%, transparent);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
  }

  .topbar-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .studio-btn {
    padding: 0.35rem 0.8rem;
    font-size: 0.8125rem;
    font-weight: 600;
    border-radius: 6px;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    border: 1px solid transparent;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease, transform 0.1s ease;
  }

  .studio-btn:hover {
    transform: translateY(-1px);
  }

  .studio-btn:active {
    transform: translateY(0);
  }

  .studio-btn:focus-visible {
    outline: 2px solid var(--docs-focus-ring);
    outline-offset: 2px;
  }

  /* Light mode buttons */
  :global([data-theme="light"]) .btn-primary {
    background: var(--docs-accent, #2563eb);
    color: #ffffff;
    box-shadow: 0 1px 3px rgba(37, 99, 235, 0.25);
  }

  :global([data-theme="light"]) .btn-primary:hover {
    background: var(--docs-link-hover, #1d4ed8);
    box-shadow: 0 2px 6px rgba(37, 99, 235, 0.35);
  }

  :global([data-theme="light"]) .btn-secondary {
    background: #ffffff;
    color: var(--docs-text, #1e293b);
    border-color: var(--docs-border, #e2e8f0);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  :global([data-theme="light"]) .btn-secondary:hover {
    background: var(--docs-surface-recessed, #f1f5f9);
    border-color: var(--docs-border-strong, #cbd5e1);
  }

  /* Dark mode buttons - Flat saturated electric royal blue & metallic black */
  :global([data-theme="dark"]) .btn-primary {
    background: var(--docs-accent, #2563eb);
    color: #ffffff;
    font-weight: 600;
    box-shadow: none;
    border: none;
  }

  :global([data-theme="dark"]) .btn-primary:hover {
    background: #1d4ed8;
    box-shadow: none;
  }

  :global([data-theme="dark"]) .btn-secondary {
    background: #141414;
    color: var(--docs-text, #f5f5f7);
    border-color: rgba(255, 255, 255, 0.14);
    box-shadow: none;
  }

  :global([data-theme="dark"]) .btn-secondary:hover {
    background: #1e1e1e;
    border-color: rgba(255, 255, 255, 0.25);
    box-shadow: none;
  }

  .btn-docs {
    background: transparent;
    color: var(--docs-text-muted);
  }

  .btn-docs:hover {
    color: var(--docs-text);
    background: var(--docs-card-hover);
  }

  .studio-main {
    flex: 1;
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 1.5rem;
    padding: 1.5rem;
    align-items: start;
    max-width: 1600px;
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .studio-controls-panel {
    background: var(--docs-surface);
    border: 1px solid var(--docs-border);
    border-radius: 10px;
    padding: 1.25rem;
    box-shadow: var(--docs-shadow-sm);
    max-height: calc(100vh - 90px);
    overflow-y: auto;
    position: sticky;
    top: 70px;
  }

  .controls-section {
    border-bottom: 1px solid var(--docs-border-subtle);
    padding-bottom: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .controls-section:last-child {
    border-bottom: none;
    padding-bottom: 0;
    margin-bottom: 0;
  }

  .section-heading {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--docs-text);
    margin: 0 0 0.875rem 0;
    letter-spacing: -0.01em;
  }

  .section-note {
    font-size: 0.75rem;
    color: var(--docs-text-muted);
    margin: -0.5rem 0 0.875rem 0;
    line-height: 1.4;
  }

  .basis-preview-scope {
    --preview-bg: var(--b-color-surface-elevated, var(--docs-surface));
    --preview-border: var(--b-color-border-default, var(--docs-border));
    --preview-text: var(--b-color-content-default, var(--docs-text));
  }

  .studio-workspace {
    flex: 1;
    background: var(--docs-surface);
    border: 1px solid var(--docs-border);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 600px;
    box-shadow: var(--docs-shadow-sm);
  }

  .studio-placeholder {
    text-align: center;
    max-width: 500px;
    padding: 2rem;
  }

  .studio-placeholder h1 {
    font-size: 1.75rem;
    margin: 0 0 0.5rem 0;
    color: var(--docs-text);
  }

  .studio-placeholder p {
    color: var(--docs-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 900px) {
    .studio-main {
      grid-template-columns: 1fr;
    }

    .studio-controls-panel {
      position: static;
      max-height: none;
    }
  }
</style>
