---
import CodeBlock from '../CodeBlock.astro';

interface Parameter {
  name: string;
  type: string;
  defaultValue?: string;
  description: string;
  optional?: boolean;
}

interface Signature {
  name: string;
  declaration: string;
  parameters: Parameter[];
  returnType?: string;
  kdoc?: string;
}

interface Sample {
  id: string;
  title: string;
  code: string;
  description?: string;
}

interface Props {
  signatures?: Signature[];
  samples?: Sample[];
}

const { signatures = [], samples = [] } = Astro.props;
---

<div class="api-section">
  <!-- Signatures & Parameters -->
  {signatures.map((sig, idx) => (
    <div class="signature-container">
      {signatures.length > 1 && (
        <h3 class="signature-title">Overload {idx + 1}: <code>{sig.name}</code></h3>
      )}

      <!-- Declaration Block -->
      <CodeBlock
        code={sig.declaration}
        lang="kotlin"
        title="Signature"
      />

      <!-- Parameters Table -->
      <div class="params-block">
        {signatures.length > 1 ? (
          <h4 class="params-heading">Parameters</h4>
        ) : (
          <h3 class="params-heading">Parameters</h3>
        )}
        {sig.parameters && sig.parameters.length > 0 ? (
          <div class="table-responsive">
            <table class="params-table">
              <colgroup>
                <col class="col-name" />
                <col class="col-type" />
                <col class="col-default" />
                <col class="col-desc" />
              </colgroup>
              <thead>
                <tr>
                  <th scope="col">Parameter</th>
                  <th scope="col">Type</th>
                  <th scope="col">Default</th>
                  <th scope="col">Description</th>
                </tr>
              </thead>
              <tbody>
                {sig.parameters.map((param) => (
                  <tr>
                    <td class="param-name-cell">
                      <code>{param.name}</code>
                    </td>
                    <td class="param-type-cell">
                      <span class="type-badge">{param.type}</span>
                    </td>
                    <td class="param-default-cell">
                      {param.defaultValue ? (
                        <code>{param.defaultValue}</code>
                      ) : (
                        <span class="required-badge">required</span>
                      )}
                    </td>
                    <td class="param-desc-cell">
                      {param.description}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="empty-params">This function takes no parameters.</p>
        )}
      </div>
    </div>
  ))}

  <!-- Sample Gallery -->
  {samples.length > 0 && (
    <div class="samples-block">
      <h3 class="section-subtitle">Usage Samples</h3>
      <div class="samples-list">
        {samples.map((sample) => (
          <div class="sample-card">
            <div class="sample-header">
              <h4 class="sample-title">{sample.title}</h4>
              {sample.description && <p class="sample-desc">{sample.description}</p>}
            </div>
            <CodeBlock
              code={sample.code}
              lang="kotlin"
              title={sample.title}
            />
          </div>
        ))}
      </div>
    </div>
  )}
</div>

<style>
  .api-section {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin: 1.5rem 0;
  }

  .signature-container {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .signature-title {
    font-size: 1.15rem;
    color: var(--docs-text, #e6edf3);
    margin: 0;
  }

  .signature-title code {
    color: var(--docs-accent, #58a6ff);
  }

  .code-wrapper {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
  }

  .code-block {
    background: var(--docs-code-bg, #161b22);
    border: 1px solid var(--docs-code-border, #21262d);
    border-radius: 8px;
    padding: 1.25rem;
    overflow-x: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--docs-text, #e6edf3);
    margin: 0;
  }

  .params-block {
    margin-top: 0.5rem;
  }

  .params-heading,
  .section-subtitle {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--docs-text, #e6edf3);
    margin: 0 0 0.875rem 0;
  }

  .table-responsive {
    width: 100%;
    overflow-x: auto;
    border: 1px solid var(--docs-border-subtle, #21262d);
    border-radius: 8px;
    background: var(--docs-surface, #161b22);
    box-sizing: border-box;
  }

  .params-table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    font-size: 0.875rem;
    text-align: left;
  }

  .col-name {
    width: 22%;
  }

  .col-type {
    width: 28%;
  }

  .col-default {
    width: 20%;
  }

  .col-desc {
    width: 30%;
  }

  .params-table th {
    padding: 0.75rem 0.875rem;
    background: var(--docs-surface-recessed, #0d0f12);
    color: var(--docs-text-muted, #8b949e);
    font-weight: 600;
    font-size: 0.8125rem;
    border-bottom: 1px solid var(--docs-border-subtle, #21262d);
    white-space: nowrap;
  }

  .params-table td {
    padding: 0.75rem 0.875rem;
    border-bottom: 1px solid var(--docs-border-subtle, #21262d);
    color: var(--docs-text, #c9d1d9);
    vertical-align: top;
    font-size: 0.8125rem;
  }

  .params-table tr:last-child td {
    border-bottom: none;
  }

  .param-name-cell code {
    color: var(--docs-text, #e6edf3);
    font-weight: 600;
    font-size: 0.8125rem;
    word-break: break-word;
  }

  .type-badge {
    color: var(--docs-accent, #58a6ff);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8125rem;
    word-break: break-word;
    overflow-wrap: anywhere;
    white-space: normal;
  }

  .required-badge {
    color: #f85149;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .param-default-cell code {
    font-size: 0.8125rem;
    color: var(--docs-text-muted, #8b949e);
    word-break: break-word;
    overflow-wrap: anywhere;
    white-space: normal;
  }

  .param-desc-cell {
    line-height: 1.5;
    word-break: normal;
    overflow-wrap: break-word;
  }

  .empty-params {
    color: var(--docs-text-muted, #8b949e);
    font-size: 0.9rem;
    margin: 0;
  }

  .samples-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sample-card {
    background: var(--docs-surface, #161b22);
    border: 1px solid var(--docs-border-subtle, #21262d);
    border-radius: 8px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .sample-header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .sample-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--docs-text, #e6edf3);
    margin: 0;
  }

  .sample-desc {
    font-size: 0.875rem;
    color: var(--docs-text-muted, #8b949e);
    margin: 0;
    line-height: 1.45;
  }
</style>
