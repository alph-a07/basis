---
interface Props {
  lifecycle: {
    status: 'stable' | 'experimental' | 'deprecated' | 'discontinued';
    addedIn?: string;
    deprecatedIn?: string;
    discontinuedIn?: string;
  };
  family?: string;
  kind?: string;
  sourceUrl?: string;
}

const { lifecycle, family, kind = 'component', sourceUrl } = Astro.props;
---

<div class="lifecycle-chips" role="group" aria-label="Component lifecycle and metadata">
  <!-- Status Badge -->
  <span class={`chip status-chip status-${lifecycle.status}`}>
    <span class="status-dot" aria-hidden="true"></span>
    <span class="status-text">{lifecycle.status}</span>
  </span>

  <!-- Version Badges -->
  {lifecycle.addedIn && (
    <span class="chip version-chip" title={`Introduced in version ${lifecycle.addedIn}`}>
      added in v{lifecycle.addedIn}
    </span>
  )}

  {lifecycle.deprecatedIn && (
    <span class="chip version-chip deprecated" title={`Deprecated in version ${lifecycle.deprecatedIn}`}>
      deprecated in v{lifecycle.deprecatedIn}
    </span>
  )}

  {lifecycle.discontinuedIn && (
    <span class="chip version-chip discontinued" title={`Discontinued in version ${lifecycle.discontinuedIn}`}>
      discontinued in v{lifecycle.discontinuedIn}
    </span>
  )}

  <!-- Family Badge -->
  {family && (
    <span class="chip family-chip" title="Component Family">
      {family}
    </span>
  )}

  <!-- Kind Badge -->
  <span class="chip kind-chip">
    {kind}
  </span>

  <!-- Source URL -->
  {sourceUrl && (
    <a
      href={sourceUrl}
      class="chip source-link"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="View source code on GitHub"
      title="View source code"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
      </svg>
      <span>source</span>
    </a>
  )}
</div>

<style>
  .lifecycle-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.02em;
  }

  .status-chip {
    text-transform: capitalize;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: currentColor;
  }

  .status-stable {
    background: var(--docs-status-pass-bg, rgba(46, 160, 67, 0.15));
    color: var(--docs-status-pass-text, #3fb950);
  }

  .status-experimental {
    background: var(--docs-status-warn-bg, rgba(210, 153, 34, 0.15));
    color: var(--docs-status-warn-text, #d29922);
  }

  .status-deprecated {
    background: rgba(248, 81, 73, 0.15);
    color: #f85149;
  }

  .status-discontinued {
    background: rgba(139, 148, 158, 0.15);
    color: #8b949e;
  }

  .version-chip {
    background: color-mix(in srgb, var(--docs-text-muted, #8b949e) 12%, transparent);
    color: var(--docs-text-muted, #8b949e);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.7rem;
  }

  .version-chip.deprecated {
    background: rgba(248, 81, 73, 0.12);
    color: #f85149;
  }

  .family-chip,
  .kind-chip {
    background: color-mix(in srgb, var(--docs-text-muted, #8b949e) 10%, transparent);
    color: var(--docs-text-muted, #8b949e);
    text-transform: uppercase;
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
  }

  .source-link {
    text-decoration: none;
    background: color-mix(in srgb, var(--docs-text-muted, #8b949e) 10%, transparent);
    color: var(--docs-text-muted, #8b949e);
    transition: color 0.15s ease, background 0.15s ease;
  }

  .source-link:hover {
    color: var(--docs-text, #e6edf3);
    background: color-mix(in srgb, var(--docs-text-muted, #8b949e) 20%, transparent);
  }

  .source-link:focus-visible {
    outline: 2px solid var(--docs-focus-ring, #58a6ff);
    outline-offset: 2px;
  }

  /* Light mode borders for visual separation */
  :global([data-theme="light"]) .chip {
    border: 1px solid var(--docs-border-subtle, #d0d7de);
  }

  :global([data-theme="light"]) .status-stable {
    border: 1px solid var(--docs-status-pass-border, rgba(46, 160, 67, 0.4));
  }

  :global([data-theme="light"]) .status-experimental {
    border: 1px solid var(--docs-status-warn-border, rgba(210, 153, 34, 0.4));
  }

  :global([data-theme="light"]) .status-deprecated {
    border: 1px solid rgba(248, 81, 73, 0.4);
  }

  :global([data-theme="light"]) .status-discontinued {
    border: 1px solid rgba(139, 148, 158, 0.4);
  }
</style>
