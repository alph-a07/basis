---
import type { NavGroup } from '../types/navigation';
import SearchModal from './SearchModal.astro';
import ThemeToggle from './ThemeToggle.astro';
import versionData from '../generated/version.json';

interface Props {
  currentPath?: string;
  componentGroups?: { family: string; components: { id: string; name: string; title?: string }[] }[];
  foundationComponents?: { id: string; name: string; title?: string }[];
  modifierGroups?: { id: string; name: string; title?: string }[];
  navGroups?: NavGroup[];
}

const {
  currentPath = '',
  componentGroups = [],
  foundationComponents = [],
  modifierGroups = [],
  navGroups = [],
} = Astro.props;

// Static documentation groups fallback
const staticGroups: NavGroup[] = [
  {
    title: 'Getting Started',
    items: [
      { title: 'Overview', href: '/docs/getting-started/overview' },
      { title: 'Installation', href: '/docs/getting-started/installation' },
      { title: 'Quickstart', href: '/docs/getting-started/quickstart' },
    ],
  },
  {
    title: 'Theming',
    items: [
      { title: 'Set your brand color', href: '/docs/theming/set-brand' },
      { title: 'Choose a mood and domain', href: '/docs/theming/mood-domain' },
      { title: 'Support dark mode', href: '/docs/theming/dark-mode' },
      { title: 'Customize components', href: '/docs/theming/customize-components' },
      { title: 'Check your theme in CI', href: '/docs/theming/check-theme-ci' },
      { title: 'Intent reference', href: '/docs/theming/intent-reference' },
      { title: 'How Basis picks colors', href: '/docs/theming/color-science' },
    ],
  },
  {
    title: 'Foundation',
    items: [],
  },
  {
    title: 'Changelog',
    items: [
      { title: 'Changelog', href: '/docs/changelog' },
    ],
  },
];

function isPathActive(itemHref: string): boolean {
  if (itemHref === currentPath) return true;
  if (itemHref.startsWith('/docs/components/')) {
    const compBase = itemHref;
    return currentPath === compBase || currentPath.startsWith(`${compBase}/`);
  }
  if (itemHref.startsWith('/docs/modifiers/')) {
    const modBase = itemHref;
    return currentPath === modBase || currentPath.startsWith(`${modBase}/`);
  }
  return false;
}

const displayGroups = navGroups.length > 0 ? navGroups : staticGroups;
---

<!-- Mobile Drawer Backdrop -->
<div id="sidebar-backdrop" class="sidebar-backdrop" aria-hidden="true"></div>

<aside id="docs-sidebar" class="docs-sidebar" aria-label="Documentation navigation">
  <div class="sidebar-inner">
    <!-- Header: Logo + Search Trigger -->
    <div class="sidebar-header">
      <div class="logo-row">
        <a href="/" class="brand-link" aria-label="Basis Home">
          <svg class="brand-logo" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="4" stroke="var(--docs-accent, #3b82f6)" stroke-width="2" />
            <circle cx="12" cy="12" r="4" fill="var(--docs-accent, #3b82f6)" />
          </svg>
          <span class="brand-title">Basis</span>
        </a>
        <button type="button" id="close-sidebar-btn" class="close-sidebar-btn" aria-label="Close navigation drawer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <button
        type="button"
        class="search-trigger open-search-btn"
        aria-label="Search documentation"
        aria-keyshortcuts="Control+K Meta+K"
      >
        <span class="search-trigger-content">
          <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span class="search-placeholder">Search docs...</span>
        </span>
        <kbd class="search-kbd">⌘K</kbd>
      </button>
    </div>

    <!-- Navigation Groups -->
    <nav class="sidebar-nav" aria-label="Sidebar Sections">
      {displayGroups.map((group) => {
        const isFoundation = group.title.toLowerCase() === 'foundation';
        return (
          <div class="nav-group">
            <h2 class="nav-group-title">{group.title}</h2>
            {group.items.length > 0 && (
              <ul class="nav-group-list">
                {group.items.map((item) => {
                  const active = isPathActive(item.href);
                  return (
                    <li class="nav-item">
                      <a
                        href={item.href}
                        class={`nav-link ${active ? 'active' : ''}`}
                        aria-current={active ? 'page' : undefined}
                      >
                        <span>{item.title}</span>
                        {item.badge && <span class="nav-badge">{item.badge}</span>}
                      </a>
                    </li>
                  );
                })}
              </ul>
            )}

            {isFoundation && (
              <div class="foundation-subgroups">
                {foundationComponents.length > 0 && (
                  <details class="nav-subgroup" data-family="components" open>
                    <summary class="nav-subgroup-title">
                      <span class="nav-subgroup-label">Components</span>
                      <svg
                        class="nav-subgroup-chevron"
                        width="12"
                        height="12"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <polyline points="9 18 15 12 9 6"></polyline>
                      </svg>
                    </summary>
                    <ul class="nav-group-list subgroup-list">
                      {foundationComponents.map((comp) => {
                        const href = `/docs/components/${comp.id}`;
                        const active = isPathActive(href);
                        return (
                          <li class="nav-item">
                            <a
                              href={href}
                              class={`nav-link subgroup-link ${active ? 'active' : ''}`}
                              aria-current={active ? 'page' : undefined}
                            >
                              <span>{comp.title || comp.name}</span>
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </details>
                )}

                {modifierGroups.length > 0 && (
                  <details class="nav-subgroup" data-family="modifiers" open>
                    <summary class="nav-subgroup-title">
                      <span class="nav-subgroup-label">Modifiers</span>
                      <svg
                        class="nav-subgroup-chevron"
                        width="12"
                        height="12"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <polyline points="9 18 15 12 9 6"></polyline>
                      </svg>
                    </summary>
                    <ul class="nav-group-list subgroup-list">
                      {modifierGroups.map((mod) => {
                        const href = `/docs/modifiers/${mod.id}`;
                        const active = isPathActive(href);
                        return (
                          <li class="nav-item">
                            <a
                              href={href}
                              class={`nav-link subgroup-link ${active ? 'active' : ''}`}
                              aria-current={active ? 'page' : undefined}
                            >
                              <span>{mod.title || mod.name}</span>
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </details>
                )}
              </div>
            )}
          </div>
        );
      })}

      {componentGroups.length > 0 && (
        <div class="nav-group components-group">
          <h2 class="nav-group-title">Components</h2>
          <div class="component-families">
            {componentGroups.map((group) => (
              <details class="nav-subgroup" data-family={group.family.toLowerCase()} open>
                <summary class="nav-subgroup-title">
                  <span class="nav-subgroup-label">{group.family}</span>
                  <svg
                    class="nav-subgroup-chevron"
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </summary>
                <ul class="nav-group-list subgroup-list">
                  {group.components.map((comp) => {
                    const href = `/docs/components/${comp.id}`;
                    const active = isPathActive(href);
                    return (
                      <li class="nav-item">
                        <a
                          href={href}
                          class={`nav-link subgroup-link ${active ? 'active' : ''}`}
                          aria-current={active ? 'page' : undefined}
                        >
                          <span>{comp.title || comp.name}</span>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </details>
            ))}
          </div>
        </div>
      )}
    </nav>

    <!-- Footer: Version + Theme Toggle + GitHub -->
    <div class="sidebar-footer">
      <div class="footer-meta">
        <span class="version-badge" title="Basis Version">{versionData.versionName}</span>
      </div>
      <div class="footer-actions">
        <ThemeToggle id="theme-toggle" />
        <a
          href="https://github.com/alph-a07/basis"
          class="github-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Basis on GitHub"
          title="GitHub Repository"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</aside>

<SearchModal />

<script>
  function setupSidebarDrawer() {
    const sidebar = document.getElementById('docs-sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');
    const closeBtn = document.getElementById('close-sidebar-btn');
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');

    function openDrawer() {
      if (!sidebar || !backdrop) return;
      sidebar.classList.add('drawer-open');
      backdrop.classList.add('visible');
      mobileMenuBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      if (!sidebar || !backdrop) return;
      sidebar.classList.remove('drawer-open');
      backdrop.classList.remove('visible');
      mobileMenuBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    mobileMenuBtn?.addEventListener('click', () => {
      const isOpen = sidebar?.classList.contains('drawer-open');
      if (isOpen) {
        closeDrawer();
      } else {
        openDrawer();
      }
    });

    closeBtn?.addEventListener('click', closeDrawer);
    backdrop?.addEventListener('click', closeDrawer);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && sidebar?.classList.contains('drawer-open')) {
        closeDrawer();
      }
    });

    // Subgroup collapse/expand state persistence
    const subgroups = document.querySelectorAll<HTMLDetailsElement>('details.nav-subgroup');
    subgroups.forEach((details) => {
      const family = details.dataset.family;
      if (!family) return;

      const hasActiveChild = details.querySelector('.nav-link.active') !== null;
      if (hasActiveChild) {
        details.open = true;
      } else {
        try {
          const saved = localStorage.getItem(`basis-subgroup-${family}`);
          if (saved === 'closed') {
            details.open = false;
          } else if (saved === 'open') {
            details.open = true;
          }
        } catch (_) {}
      }

      details.addEventListener('toggle', () => {
        try {
          localStorage.setItem(`basis-subgroup-${family}`, details.open ? 'open' : 'closed');
        } catch (_) {}
      });
    });
  }

  setupSidebarDrawer();
  document.addEventListener('astro:page-load', setupSidebarDrawer);
</script>

<style>
  .docs-sidebar {
    width: 270px;
    height: 100vh;
    position: sticky;
    top: 0;
    flex-shrink: 0;
    background: var(--docs-surface);
    border-right: 1px solid var(--docs-border);
    z-index: 50;
    display: flex;
    flex-direction: column;
  }

  .sidebar-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .sidebar-header {
    padding: 0.85rem 1rem 0.75rem 1rem;
    border-bottom: 1px solid var(--docs-border-subtle);
  }

  .logo-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.65rem;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--docs-text);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .brand-link:focus-visible {
    outline: 2px solid var(--docs-focus-ring);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .brand-logo {
    display: block;
  }

  .close-sidebar-btn {
    display: none;
    background: transparent;
    border: none;
    color: var(--docs-text-muted);
    cursor: pointer;
    padding: 0.25rem;
  }

  .close-sidebar-btn:focus-visible {
    outline: 2px solid var(--docs-focus-ring);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .search-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.375rem 0.625rem;
    background: var(--docs-surface-recessed);
    border: 1px solid var(--docs-border);
    border-radius: 6px;
    color: var(--docs-text-muted);
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .search-trigger:hover {
    border-color: var(--docs-accent);
    background: var(--docs-card-hover);
    color: var(--docs-text);
  }

  .search-trigger:focus-visible {
    outline: 2px solid var(--docs-focus-ring);
    outline-offset: 2px;
  }

  .search-trigger-content {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .search-placeholder {
    font-size: 0.8125rem;
  }

  .search-kbd {
    background: var(--docs-surface);
    border: 1px solid var(--docs-border-subtle);
    border-radius: 4px;
    padding: 0.05rem 0.3rem;
    font-size: 0.6875rem;
    font-family: var(--docs-font-mono);
    color: var(--docs-text-muted);
  }

  .sidebar-nav {
    flex: 1;
    overflow-y: auto;
    padding: 0.75rem 0.65rem;
    scrollbar-width: thin;
    scrollbar-color: var(--docs-border-subtle, #30363d) transparent;
  }

  .nav-group {
    margin-bottom: 0.5rem;
  }

  .nav-group + .nav-group {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--docs-border-subtle, #21262d);
  }

  .nav-group:last-child {
    margin-bottom: 0.25rem;
  }

  .nav-group-title {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--docs-text-muted, #8b949e) 85%, var(--docs-text, #e6edf3));
    padding: 0 0.5rem;
    margin: 0 0 0.35rem 0;
  }

  .component-families,
  .foundation-subgroups {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }

  .nav-subgroup {
    display: flex;
    flex-direction: column;
  }

  .nav-subgroup-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--docs-text-muted, #8b949e);
    padding: 0.2rem 0.5rem;
    margin: 0.1rem 0;
    border-radius: 4px;
    cursor: pointer;
    user-select: none;
    list-style: none;
    transition: color 0.12s ease, background 0.12s ease;
  }

  .nav-subgroup-title::-webkit-details-marker {
    display: none;
  }

  .nav-subgroup-title:hover {
    color: var(--docs-text, #e6edf3);
    background: color-mix(in srgb, var(--docs-text-muted, #8b949e) 8%, transparent);
  }

  .nav-subgroup-title:focus-visible {
    outline: 2px solid var(--docs-focus-ring, #58a6ff);
    outline-offset: -1px;
  }

  .nav-subgroup-label {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .nav-subgroup-chevron {
    color: var(--docs-text-muted, #8b949e);
    transition: transform 0.15s ease, color 0.12s ease;
    flex-shrink: 0;
  }

  .nav-subgroup[open] > .nav-subgroup-title .nav-subgroup-chevron {
    transform: rotate(90deg);
  }

  .nav-subgroup-title:hover .nav-subgroup-chevron {
    color: var(--docs-text, #e6edf3);
  }

  .subgroup-list {
    margin-left: 0.75rem;
    padding-left: 0.45rem;
    border-left: 1px solid var(--docs-border-subtle, #21262d);
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin-top: 0.15rem;
  }

  .subgroup-link {
    padding: 0.25rem 0.45rem;
  }

  .nav-group-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-item {
    margin-bottom: 0.1rem;
  }

  .nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.275rem 0.5rem;
    color: var(--docs-text-muted);
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.4;
    transition: color 0.12s ease;
  }

  .nav-link:hover {
    color: var(--docs-text);
  }

  .nav-link:visited {
    color: var(--docs-text-muted);
  }

  .nav-link.active {
    color: var(--docs-accent);
    font-weight: 600;
  }

  .nav-link.active:visited {
    color: var(--docs-accent);
  }

  .nav-badge {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    background: var(--docs-sidebar-active-bg);
    color: var(--docs-accent);
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--docs-focus-ring);
    outline-offset: -1px;
  }

  .sidebar-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1rem;
    border-top: 1px solid var(--docs-border-subtle);
    background: var(--docs-surface);
  }

  .version-badge {
    font-size: 0.7rem;
    color: var(--docs-text-muted);
    font-family: var(--docs-font-mono);
    background: var(--docs-surface-recessed);
    border: 1px solid var(--docs-border-subtle);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  .footer-actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .theme-toggle-btn,
  .github-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    color: var(--docs-text-muted);
    background: transparent;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .theme-toggle-btn:hover,
  .github-link:hover {
    color: var(--docs-text);
    background: var(--docs-card-hover);
  }

  .theme-toggle-btn:focus-visible,
  .github-link:focus-visible {
    outline: 2px solid var(--docs-focus-ring, #3b82f6);
    outline-offset: 2px;
  }

  :global([data-theme="dark"]) .sun-icon {
    display: block;
  }

  :global([data-theme="dark"]) .moon-icon {
    display: none;
  }

  :global([data-theme="light"]) .sun-icon {
    display: none;
  }

  :global([data-theme="light"]) .moon-icon {
    display: block;
  }

  .sidebar-backdrop {
    display: none;
  }

  /* Responsive Drawer styles */
  @media (max-width: 1024px) {
    .docs-sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      transform: translateX(-100%);
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: none;
    }

    .docs-sidebar.drawer-open {
      transform: translateX(0);
      box-shadow: 0 0 40px rgba(0, 0, 0, 0.8);
    }

    .close-sidebar-btn {
      display: flex;
    }

    .sidebar-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.65);
      backdrop-filter: blur(2px);
      z-index: 40;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
    }

    .sidebar-backdrop.visible {
      opacity: 1;
      pointer-events: auto;
    }
  }
</style>
