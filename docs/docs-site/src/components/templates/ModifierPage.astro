---
import LifecycleChips from '../sections/LifecycleChips.astro';
import ApiTable from '../sections/ApiTable.astro';
import GuidelinesCard from '../sections/GuidelinesCard.astro';
import A11yFacts from '../sections/A11yFacts.astro';
import CodeBlock from '../CodeBlock.astro';

interface Props {
  modifier: any;
  sidecar?: any;
  activeTab: 'overview' | 'api';
}

const { modifier, sidecar, activeTab } = Astro.props;

function getA11yNarrative(sidecarEntry: any): string | undefined {
  if (!sidecarEntry?.body) return undefined;
  const match = sidecarEntry.body.match(/##\s+Accessibility\s*\n+([\s\S]*?)(?=\n##|\s*$)/i);
  return match ? match[1].trim() : undefined;
}

const a11yNarrative = getA11yNarrative(sidecar);

const tabs = [
  { id: 'overview', label: 'Overview', path: `/docs/modifiers/${modifier.id}` },
  { id: 'api', label: 'API', path: `/docs/modifiers/${modifier.id}/api` },
];
---

<article class="modifier-page" data-modifier-id={modifier.id}>
  <!-- Header -->
  <header class="modifier-header">
    <div class="header-meta-row">
      <LifecycleChips
        lifecycle={modifier.lifecycle}
        family={modifier.family}
        kind="modifier"
        sourceUrl={modifier.sourceUrl}
      />
    </div>

    <h1 class="modifier-title">{modifier.name}</h1>
    <p class="modifier-summary">{modifier.summary}</p>
    {modifier.description && modifier.description !== modifier.summary && (
      <p class="modifier-description">{modifier.description}</p>
    )}

    <!-- Route-Per-Tab Navigation -->
    <nav class="modifier-tabs" aria-label="Modifier sections">
      {tabs.map((tab) => {
        const isActive = activeTab === tab.id;
        return (
          <a
            href={tab.path}
            class={`tab-link ${isActive ? 'active' : ''}`}
            aria-current={isActive ? 'page' : undefined}
          >
            {tab.label}
          </a>
        );
      })}
    </nav>
  </header>

  <!-- Tab Content Body -->
  <div class="tab-body">
    <!-- Overview Tab -->
    {activeTab === 'overview' && (
      <section class="tab-pane" aria-labelledby="tab-overview">
        <!-- Quick Start -->
        {modifier.overview?.quickStartSample && (
          <div class="modifier-section">
            <h2 id="quick-start">Quick Start</h2>
            <CodeBlock
              code={modifier.overview.quickStartSample}
              lang="kotlin"
            />
          </div>
        )}

        <!-- Accessibility -->
        {modifier.accessibility && (
          <div class="modifier-section">
            <h2 id="accessibility">Accessibility Behavior</h2>
            <A11yFacts
              accessibility={modifier.accessibility}
              narrative={a11yNarrative}
            />
          </div>
        )}

        <!-- Guidelines -->
        {sidecar?.data?.guidelines && (
          <div class="modifier-section">
            <h2 id="guidelines">Usage Guidelines</h2>
            <GuidelinesCard
              guidelines={sidecar.data.guidelines}
            />
          </div>
        )}
      </section>
    )}

    <!-- API Tab -->
    {activeTab === 'api' && (
      <section class="tab-pane" aria-labelledby="tab-api">
        <h2 id="signatures">Signatures & Parameters</h2>
        <ApiTable
          signatures={modifier.api?.signatures}
          samples={modifier.api?.samples}
        />
      </section>
    )}
  </div>
</article>

<style>
  .modifier-page {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .modifier-header {
    padding-bottom: 0;
  }

  .header-meta-row {
    margin-bottom: 0.5rem;
  }

  .modifier-title {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: var(--docs-text, #e6edf3);
    margin: 0.1rem 0 0.25rem 0;
  }

  .modifier-summary {
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--docs-text-muted, #8b949e);
    margin: 0 0 0.45rem 0;
  }

  .modifier-description {
    font-size: 0.925rem;
    line-height: 1.55;
    color: var(--docs-text, #c9d1d9);
    margin: 0 0 0.65rem 0;
  }

  .modifier-tabs {
    display: flex;
    gap: 1.5rem;
    border-bottom: 1px solid var(--docs-border-subtle, #21262d);
    padding-top: 0.35rem;
    overflow-x: auto;
  }

  .tab-link {
    text-decoration: none;
    font-size: 0.925rem;
    font-weight: 600;
    color: var(--docs-text-muted, #8b949e);
    padding: 0.45rem 0.25rem 0.55rem;
    margin-bottom: -1px;
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .tab-link:hover {
    color: var(--docs-text, #e6edf3);
  }

  .tab-link.active {
    color: var(--docs-accent, #58a6ff);
    border-bottom-color: var(--docs-accent, #58a6ff);
  }

  .tab-body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .tab-pane {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .modifier-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  h2 {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--docs-text, #e6edf3);
    margin: 0;
    scroll-margin-top: 5rem;
  }
</style>
