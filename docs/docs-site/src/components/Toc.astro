---
import type { TocItem } from '../types/navigation';

interface Props {
  headings?: TocItem[];
}

const { headings = [] } = Astro.props;
---

{headings.length > 0 && (
  <nav class="docs-toc" aria-label="Table of contents">
    <div class="toc-inner">
      <div class="toc-divider" aria-hidden="true" title="Scroll progress">
        <div class="toc-divider-track"></div>
        <div class="toc-divider-glow" id="toc-scroll-indicator"></div>
      </div>
      <h2 class="toc-heading">On this page</h2>
      <ul class="toc-list">
        {headings.map((item) => (
          <li class={`toc-item depth-${item.depth}`}>
            <a
              href={`#${item.slug}`}
              class="toc-link"
              data-slug={item.slug}
            >
              {item.text}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
)}

<script>
  function setupToc() {
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    const divider = document.querySelector<HTMLElement>('.toc-divider');
    const indicator = document.getElementById('toc-scroll-indicator');

    if (!tocLinks.length || !divider || !indicator) return;

    interface TocPair {
      el: HTMLElement;
      link: HTMLAnchorElement;
      slug: string;
    }

    const items: TocPair[] = [];
    tocLinks.forEach((link) => {
      const slug = link.getAttribute('data-slug');
      if (slug) {
        const el = document.getElementById(slug);
        if (el) {
          items.push({ el, link, slug });
        }
      }
    });

    if (!items.length) return;

    function getElementTop(el: HTMLElement): number {
      return el.getBoundingClientRect().top + window.scrollY;
    }

    function setActiveLink(activeSlug: string) {
      items.forEach((item) => {
        if (item.slug === activeSlug) {
          item.link.classList.add('active');
          item.link.setAttribute('aria-current', 'true');
        } else {
          item.link.classList.remove('active');
          item.link.removeAttribute('aria-current');
        }
      });
    }

    function updateProgress() {
      const scrollY = window.scrollY;
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;

      if (maxScroll <= 0) {
        if (indicator) {
          indicator.style.height = '0px';
          indicator.classList.remove('is-active');
        }
        setActiveLink(items[0].slug);
        return;
      }

      if (!divider || !indicator) return;
      const dividerRect = divider.getBoundingClientRect();
      const firstOffset = Math.max(0, getElementTop(items[0].el) - 120);
      const firstLinkRect = items[0].link.getBoundingClientRect();
      const firstCenter = (firstLinkRect.top - dividerRect.top) + (firstLinkRect.height / 2);

      // Above the first heading
      if (scrollY < firstOffset) {
        if (scrollY <= 10) {
          indicator.style.height = '0px';
          indicator.classList.remove('is-active');
        } else {
          const ratio = firstOffset > 0 ? scrollY / firstOffset : 0;
          indicator.style.height = `${(ratio * firstCenter).toFixed(1)}px`;
          indicator.classList.add('is-active');
        }
        setActiveLink(items[0].slug);
        return;
      }

      // Check if at the bottom of the page
      const isAtBottom = window.innerHeight + scrollY >= document.documentElement.scrollHeight - 15;
      if (isAtBottom) {
        const lastIndex = items.length - 1;
        setActiveLink(items[lastIndex].slug);
        const lastLinkRect = items[lastIndex].link.getBoundingClientRect();
        const lastBottom = (lastLinkRect.bottom - dividerRect.top);
        indicator.style.height = `${lastBottom.toFixed(1)}px`;
        indicator.classList.add('is-active');
        return;
      }

      // Find the current active heading index
      let activeIndex = 0;
      for (let i = 0; i < items.length; i++) {
        const offset = getElementTop(items[i].el) - 120;
        if (scrollY >= offset) {
          activeIndex = i;
        } else {
          break;
        }
      }

      setActiveLink(items[activeIndex].slug);

      const activeLinkRect = items[activeIndex].link.getBoundingClientRect();
      const activeCenter = (activeLinkRect.top - dividerRect.top) + (activeLinkRect.height / 2);

      let targetHeight = activeCenter;

      if (activeIndex < items.length - 1) {
        const currentOffset = getElementTop(items[activeIndex].el) - 120;
        const nextOffset = getElementTop(items[activeIndex + 1].el) - 120;
        const nextLinkRect = items[activeIndex + 1].link.getBoundingClientRect();
        const nextCenter = (nextLinkRect.top - dividerRect.top) + (nextLinkRect.height / 2);

        if (nextOffset > currentOffset) {
          const segmentProgress = Math.min(Math.max((scrollY - currentOffset) / (nextOffset - currentOffset), 0), 1);
          targetHeight = activeCenter + segmentProgress * (nextCenter - activeCenter);
        }
      } else {
        const currentOffset = getElementTop(items[activeIndex].el) - 120;
        const lastBottom = (activeLinkRect.bottom - dividerRect.top);
        if (maxScroll > currentOffset) {
          const tailProgress = Math.min(Math.max((scrollY - currentOffset) / (maxScroll - currentOffset), 0), 1);
          targetHeight = activeCenter + tailProgress * (lastBottom - activeCenter);
        }
      }

      indicator.style.height = `${targetHeight.toFixed(1)}px`;
      indicator.classList.add('is-active');
    }

    divider.addEventListener('click', (e) => {
      const rect = divider.getBoundingClientRect();
      const clickY = e.clientY - rect.top;
      let closestIndex = 0;
      let minDiff = Infinity;

      items.forEach((item, idx) => {
        const linkRect = item.link.getBoundingClientRect();
        const center = (linkRect.top - rect.top) + (linkRect.height / 2);
        const diff = Math.abs(clickY - center);
        if (diff < minDiff) {
          minDiff = diff;
          closestIndex = idx;
        }
      });

      if (items[closestIndex]) {
        const targetY = getElementTop(items[closestIndex].el) - 80;
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({
          top: Math.max(0, targetY),
          behavior: prefersReducedMotion ? 'auto' : 'smooth',
        });
      }
    });

    tocLinks.forEach((link) => {
      link.addEventListener('click', () => {
        const slug = link.getAttribute('data-slug');
        if (slug) {
          setActiveLink(slug);
          setTimeout(updateProgress, 50);
        }
      });
    });

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress, { passive: true });
    updateProgress();
  }

  setupToc();
  document.addEventListener('astro:page-load', setupToc);
</script>

<style>
  .docs-toc {
    width: 220px;
    position: sticky;
    top: 2rem;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    padding-left: 1.5rem;
    flex-shrink: 0;
  }

  .toc-inner {
    position: relative;
    padding-left: 1rem;
  }

  .toc-divider {
    position: absolute;
    left: -4px;
    top: 0;
    bottom: 0;
    width: 12px;
    cursor: pointer;
  }

  .toc-divider-track {
    position: absolute;
    left: 4px;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: var(--docs-border-subtle, #21262d);
  }

  .toc-divider-glow {
    position: absolute;
    left: 3.5px;
    top: 0;
    width: 2px;
    height: 0%;
    border-radius: 9999px;
    background: linear-gradient(
      180deg,
      var(--docs-accent) 0%,
      var(--docs-focus-ring) 100%
    );
    box-shadow: 0 0 8px color-mix(in srgb, var(--docs-accent) 70%, transparent),
      0 0 14px color-mix(in srgb, var(--docs-focus-ring) 45%, transparent);
    opacity: 0;
    transition: height 0.08s ease-out, opacity 0.2s ease;
  }

  .toc-divider-glow.is-active {
    opacity: 1;
  }

  .toc-divider:hover .toc-divider-glow {
    box-shadow: 0 0 10px var(--docs-accent), 0 0 20px var(--docs-focus-ring);
  }

  .toc-heading {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--docs-text-muted, #8b949e);
    margin: 0 0 0.75rem 0;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    margin-bottom: 0.4rem;
  }

  .toc-item.depth-3 {
    padding-left: 0.75rem;
  }

  .toc-link {
    display: block;
    font-size: 0.8125rem;
    color: var(--docs-text-muted, #8b949e);
    text-decoration: none;
    line-height: 1.4;
    transition: color 0.12s ease;
  }

  .toc-link:hover {
    color: var(--docs-text, #e6edf3);
  }

  .toc-link.active {
    color: var(--docs-toc-active, #58a6ff);
    font-weight: 600;
  }

  .toc-link:focus-visible {
    outline: 2px solid var(--docs-focus-ring, #58a6ff);
    outline-offset: 2px;
    border-radius: 2px;
  }

  @media (max-width: 1200px) {
    .docs-toc {
      display: none;
    }
  }
</style>
