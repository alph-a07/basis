---
import type { TocItem } from '../types/navigation';

interface Props {
  headings?: TocItem[];
}

const { headings = [] } = Astro.props;

// Determine baseline minimum depth to calculate relative indentations
const minDepth = headings.length > 0 ? Math.min(...headings.map((h) => h.depth)) : 2;
---

{headings.length > 0 && (
  <nav class="docs-toc" aria-label="Table of contents">
    <div class="toc-inner">
      <div class="toc-divider" aria-hidden="true" title="Scroll progress">
        <div class="toc-divider-track"></div>
        <div class="toc-divider-glow" id="toc-scroll-indicator"></div>
      </div>
      <h2 class="toc-heading">On this page</h2>
      <ul class="toc-list">
        {headings.map((item) => {
          const relDepth = Math.max(0, item.depth - minDepth);
          return (
            <li
              class={`toc-item depth-${item.depth} rel-depth-${relDepth} ${relDepth > 0 ? 'has-indent' : ''}`}
              style={`--rel-depth: ${relDepth};`}
            >
              <a
                href={`#${item.slug}`}
                class="toc-link"
                data-slug={item.slug}
              >
                {item.text}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </nav>
)}

<script>
  function setupToc() {
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    const divider = document.querySelector<HTMLElement>('.toc-divider');
    const indicator = document.getElementById('toc-scroll-indicator');

    if (!tocLinks.length || !divider || !indicator) return;

    document.documentElement.setAttribute('data-has-toc', 'true');

    interface TocPair {
      el: HTMLElement;
      link: HTMLAnchorElement;
      slug: string;
    }

    const items: TocPair[] = [];
    tocLinks.forEach((link) => {
      const slug = link.getAttribute('data-slug');
      if (slug) {
        const el = document.getElementById(slug);
        if (el) {
          items.push({ el, link, slug });
        }
      }
    });

    if (!items.length) return;

    function getElementTop(el: HTMLElement): number {
      return el.getBoundingClientRect().top + window.scrollY;
    }

    function setActiveLink(activeSlug: string) {
      items.forEach((item) => {
        if (item.slug === activeSlug) {
          item.link.classList.add('active');
          item.link.setAttribute('aria-current', 'true');
        } else {
          item.link.classList.remove('active');
          item.link.removeAttribute('aria-current');
        }
      });
    }

  let ticking = false;
    function updateProgress() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
      if (!indicator || !divider) return;
      const scrollY = window.scrollY;
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;

      // 1. Normal continuous page scroll progress for the TOC progress bar indicator
      if (maxScroll <= 0) {
        indicator.style.height = '0%';
        indicator.classList.remove('is-active');
      } else {
        const progress = Math.min(Math.max(scrollY / maxScroll, 0), 1);
        indicator.style.height = `${(progress * 100)}%`;
        if (progress > 0) {
          indicator.classList.add('is-active');
        } else {
          indicator.classList.remove('is-active');
        }
      }

      // 2. Retain heading section highlighting in the TOC list
      const isAtBottom = maxScroll > 0 && window.innerHeight + scrollY >= document.documentElement.scrollHeight - 15;
      if (isAtBottom) {
        setActiveLink(items[items.length - 1].slug);
        return;
      }

      let activeIndex = 0;
      for (let i = 0; i < items.length; i++) {
        const offset = getElementTop(items[i].el) - 120;
        if (scrollY >= offset) {
          activeIndex = i;
        } else {
          break;
        }
      }

      setActiveLink(items[activeIndex].slug);
      });
    }

    divider.addEventListener('click', (e) => {
      const rect = divider.getBoundingClientRect();
      if (rect.height <= 0) return;
      const clickRatio = Math.min(Math.max((e.clientY - rect.top) / rect.height, 0), 1);
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      const targetY = clickRatio * maxScroll;
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({
        top: Math.max(0, targetY),
        behavior: prefersReducedMotion ? 'auto' : 'smooth',
      });
    });

    tocLinks.forEach((link) => {
      link.addEventListener('click', () => {
        const slug = link.getAttribute('data-slug');
        if (slug) {
          setActiveLink(slug);
          setTimeout(updateProgress, 50);
        }
      });
    });

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress, { passive: true });
    updateProgress();
  }

  setupToc();
  document.addEventListener('astro:page-load', setupToc);
</script>

<style>
  .docs-toc {
    width: 220px;
    position: sticky;
    top: 2rem;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    padding-left: 1.5rem;
    flex-shrink: 0;
  }

  .toc-inner {
    position: relative;
    padding-left: 1rem;
  }

  .toc-divider {
    position: absolute;
    left: -4px;
    top: 0;
    bottom: 0;
    width: 12px;
    cursor: pointer;
  }

  .toc-divider-track {
    position: absolute;
    left: 4px;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: var(--docs-border-subtle, #21262d);
  }

  .toc-divider-glow {
    position: absolute;
    left: 3.5px;
    top: 0;
    width: 2px;
    height: 0%;
    border-radius: 9999px;
    background: linear-gradient(
      180deg,
      var(--docs-accent) 0%,
      var(--docs-focus-ring) 100%
    );
    box-shadow: 0 0 8px color-mix(in srgb, var(--docs-accent) 70%, transparent),
      0 0 14px color-mix(in srgb, var(--docs-focus-ring) 45%, transparent);
    opacity: 0;
    transition: height 0.15s ease-out, opacity 0.2s ease;
  }

  .toc-divider-glow.is-active {
    opacity: 1;
  }

  .toc-divider:hover .toc-divider-glow {
    box-shadow: 0 0 10px var(--docs-accent), 0 0 20px var(--docs-focus-ring);
  }

  .toc-heading {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--docs-text-muted, #8b949e);
    margin: 0 0 0.75rem 0;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    margin-bottom: 0.35rem;
    padding-left: calc(var(--rel-depth, 0) * 0.85rem);
    transition: padding-left 0.15s ease;
  }

  .toc-item.rel-depth-0 {
    margin-top: 0.5rem;
  }

  .toc-item.rel-depth-0:first-child {
    margin-top: 0;
  }

  .toc-item.has-indent .toc-link {
    font-size: 0.78125rem;
    line-height: 1.35;
    opacity: 0.9;
  }

  .toc-item.has-indent .toc-link.active {
    opacity: 1;
  }

  .toc-link {
    display: block;
    font-size: 0.8125rem;
    color: var(--docs-text-muted, #8b949e);
    text-decoration: none;
    line-height: 1.4;
    font-weight: 500;
    transition: color 0.12s ease;
  }
  .toc-link.active {
    color: var(--docs-toc-active, #58a6ff);
  }

  .toc-link:hover {
    color: var(--docs-text, #e6edf3);
  }

  .toc-link:visited {
    color: var(--docs-text-muted, #8b949e);
  }

  .toc-link.active:visited {
    color: var(--docs-toc-active, #58a6ff);
  }

  .toc-link:focus-visible {
    outline: 2px solid var(--docs-focus-ring, #58a6ff);
    outline-offset: 2px;
    border-radius: 2px;
  }

  @media (max-width: 1200px) {
    .docs-toc {
      display: none;
    }
  }
</style>
