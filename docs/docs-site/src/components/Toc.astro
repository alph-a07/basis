---
import type { TocItem } from '../types/navigation';

interface Props {
  headings?: TocItem[];
}

const { headings = [] } = Astro.props;
---

{headings.length > 0 && (
  <nav class="docs-toc" aria-label="Table of contents">
    <div class="toc-inner">
      <div class="toc-divider" aria-hidden="true" title="Scroll progress">
        <div class="toc-divider-track"></div>
        <div class="toc-divider-glow" id="toc-scroll-indicator"></div>
      </div>
      <h2 class="toc-heading">On this page</h2>
      <ul class="toc-list">
        {headings.map((item) => (
          <li class={`toc-item depth-${item.depth}`}>
            <a
              href={`#${item.slug}`}
              class="toc-link"
              data-slug={item.slug}
            >
              {item.text}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
)}

<script>
  function setupTocScrollSpy() {
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    if (!tocLinks.length) return;

    const headingElements: HTMLElement[] = [];
    tocLinks.forEach((link) => {
      const slug = link.getAttribute('data-slug');
      if (slug) {
        const el = document.getElementById(slug);
        if (el) headingElements.push(el);
      }
    });

    if (!headingElements.length) return;

    function setActiveLink(activeSlug: string) {
      tocLinks.forEach((link) => {
        if (link.getAttribute('data-slug') === activeSlug) {
          link.classList.add('active');
          link.setAttribute('aria-current', 'true');
        } else {
          link.classList.remove('active');
          link.removeAttribute('aria-current');
        }
      });
    }

    // Initialize IntersectionObserver to observe heading visibility
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActiveLink(entry.target.id);
            break;
          }
        }
      },
      {
        rootMargin: '0px 0px -70% 0px',
        threshold: 0,
      }
    );

    headingElements.forEach((el) => observer.observe(el));

    // Fallback: Check scroll position on scroll
    function onScroll() {
      const scrollY = window.scrollY;
      let currentSlug = headingElements[0]?.id || '';
      for (const el of headingElements) {
        if (el.offsetTop - 120 <= scrollY) {
          currentSlug = el.id;
        } else {
          break;
        }
      }
      if (currentSlug) {
        setActiveLink(currentSlug);
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  function setupTocScrollIndicator() {
    const indicator = document.getElementById('toc-scroll-indicator');
    const divider = document.querySelector<HTMLElement>('.toc-divider');
    if (!indicator || !divider) return;

    function updateProgress() {
      const scrollY = window.scrollY;
      const totalScroll = document.documentElement.scrollHeight - window.innerHeight;
      if (totalScroll <= 0) {
        if (indicator) {
          indicator.style.height = '0%';
          indicator.classList.remove('is-active');
        }
        return;
      }

      const progress = Math.min(Math.max(scrollY / totalScroll, 0), 1);
      if (indicator) {
        indicator.style.height = `${(progress * 100).toFixed(1)}%`;
        if (progress > 0.005) {
          indicator.classList.add('is-active');
        } else {
          indicator.classList.remove('is-active');
        }
      }
    }

    divider.addEventListener('click', (e) => {
      const rect = divider.getBoundingClientRect();
      const clickRatio = (e.clientY - rect.top) / rect.height;
      const totalScroll = document.documentElement.scrollHeight - window.innerHeight;
      window.scrollTo({
        top: Math.max(0, Math.min(clickRatio * totalScroll, totalScroll)),
        behavior: 'smooth',
      });
    });

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress, { passive: true });
    updateProgress();
  }

  function initToc() {
    setupTocScrollSpy();
    setupTocScrollIndicator();
  }

  initToc();
  document.addEventListener('astro:page-load', initToc);
</script>

<style>
  .docs-toc {
    width: 220px;
    position: sticky;
    top: 2rem;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    padding-left: 1.5rem;
    flex-shrink: 0;
  }

  .toc-inner {
    position: relative;
    padding-left: 1rem;
  }

  .toc-divider {
    position: absolute;
    left: -4px;
    top: 0;
    bottom: 0;
    width: 12px;
    cursor: pointer;
  }

  .toc-divider-track {
    position: absolute;
    left: 4px;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: var(--docs-border-subtle, #21262d);
  }

  .toc-divider-glow {
    position: absolute;
    left: 3.5px;
    top: 0;
    width: 2px;
    height: 0%;
    border-radius: 9999px;
    background: linear-gradient(
      180deg,
      var(--docs-accent) 0%,
      var(--docs-focus-ring) 100%
    );
    box-shadow: 0 0 8px color-mix(in srgb, var(--docs-accent) 70%, transparent),
      0 0 14px color-mix(in srgb, var(--docs-focus-ring) 45%, transparent);
    opacity: 0;
    transition: height 0.08s ease-out, opacity 0.2s ease;
  }

  .toc-divider-glow.is-active {
    opacity: 1;
  }

  .toc-divider:hover .toc-divider-glow {
    box-shadow: 0 0 10px var(--docs-accent), 0 0 20px var(--docs-focus-ring);
  }

  .toc-heading {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--docs-text-muted, #8b949e);
    margin: 0 0 0.75rem 0;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    margin-bottom: 0.4rem;
  }

  .toc-item.depth-3 {
    padding-left: 0.75rem;
  }

  .toc-link {
    display: block;
    font-size: 0.8125rem;
    color: var(--docs-text-muted, #8b949e);
    text-decoration: none;
    line-height: 1.4;
    transition: color 0.12s ease;
  }

  .toc-link:hover {
    color: var(--docs-text, #e6edf3);
  }

  .toc-link.active {
    color: var(--docs-toc-active, #58a6ff);
    font-weight: 600;
  }

  .toc-link:focus-visible {
    outline: 2px solid var(--docs-focus-ring, #58a6ff);
    outline-offset: 2px;
    border-radius: 2px;
  }

  @media (max-width: 1200px) {
    .docs-toc {
      display: none;
    }
  }
</style>
