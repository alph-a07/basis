---
import { formatKdoc } from '../lib/format-kdoc';

interface Props {
  text?: string | null;
  html?: string | null;
  class?: string;
}

const { text, html: directHtml, class: className = '' } = Astro.props;
const html = directHtml !== undefined && directHtml !== null ? directHtml : formatKdoc(text);
---

{html && (
  <span class={`kdoc-text ${className}`.trim()} set:html={html} />
)}

<style is:global>
  .kdoc-symbol-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    text-decoration: none;
    color: var(--docs-accent, #2563eb);
    font-weight: 500;
    vertical-align: baseline;
    transition: color 0.15s ease;
  }

  .kdoc-symbol-link code {
    color: inherit;
    background: color-mix(in srgb, var(--docs-accent, #2563eb) 8%, transparent);
    padding: 0.12rem 0.38rem;
    border-radius: 4px;
    border: 1px solid color-mix(in srgb, var(--docs-accent, #2563eb) 22%, transparent);
    font-size: 0.82em;
    font-family: var(--docs-font-mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace);
    transition: background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    cursor: pointer;
  }

  .kdoc-symbol-link:hover code {
    background: color-mix(in srgb, var(--docs-accent, #2563eb) 18%, transparent);
    border-color: var(--docs-accent, #2563eb);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--docs-accent, #2563eb) 20%, transparent);
  }

  .kdoc-symbol-link.external .kdoc-external-icon,
  .kdoc-link.external .kdoc-external-icon {
    display: inline-block;
    opacity: 0.65;
    flex-shrink: 0;
    margin-left: 0.15rem;
    vertical-align: middle;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .kdoc-symbol-link:hover .kdoc-external-icon,
  .kdoc-link:hover .kdoc-external-icon {
    opacity: 1;
    transform: translate(1px, -1px);
  }

  .kdoc-symbol-ref,
  .kdoc-inline-code {
    font-family: var(--docs-font-mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace);
    font-size: 0.82em;
    padding: 0.12rem 0.38rem;
    border-radius: 4px;
    color: var(--docs-accent, #2563eb);
    background: color-mix(in srgb, var(--docs-accent, #2563eb) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--docs-accent, #2563eb) 15%, transparent);
  }

  :global([data-theme="dark"]) .kdoc-symbol-link {
    color: var(--docs-accent, #58a6ff);
  }

  :global([data-theme="dark"]) .kdoc-symbol-link code {
    background: color-mix(in srgb, var(--docs-accent, #58a6ff) 12%, transparent);
    border-color: color-mix(in srgb, var(--docs-accent, #58a6ff) 28%, transparent);
  }

  :global([data-theme="dark"]) .kdoc-symbol-link:hover code {
    background: color-mix(in srgb, var(--docs-accent, #58a6ff) 22%, transparent);
    border-color: var(--docs-accent, #58a6ff);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--docs-accent, #58a6ff) 30%, transparent);
  }

  :global([data-theme="dark"]) .kdoc-symbol-ref,
  :global([data-theme="dark"]) .kdoc-inline-code {
    color: var(--docs-accent, #58a6ff);
    background: color-mix(in srgb, var(--docs-accent, #58a6ff) 8%, transparent);
    border-color: color-mix(in srgb, var(--docs-accent, #58a6ff) 20%, transparent);
  }

  .kdoc-link {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    color: var(--docs-link, #2563eb);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .kdoc-link:hover {
    color: var(--docs-link-hover, #1d4ed8);
  }

  :global([data-theme="dark"]) .kdoc-link {
    color: var(--docs-accent, #58a6ff);
  }

  :global([data-theme="dark"]) .kdoc-link:hover {
    color: #79b8ff;
  }
</style>
