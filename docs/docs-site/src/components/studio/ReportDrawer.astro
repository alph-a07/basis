---
/**
 * ReportDrawer.astro — Resolution Report slide-over drawer for Studio.
 *
 * Displays resolution health, violations (if any), per-axis contributions,
 * active modes, and JSON export action. Operable via UI button and keyboard (Alt+R, Escape).
 */
---

<!-- Report Drawer Backdrop for overlay dismiss -->
<div id="report-drawer-backdrop" class="drawer-backdrop" aria-hidden="true"></div>

<aside
  id="studio-report-drawer"
  class="studio-report-drawer"
  role="region"
  aria-label="Resolution Report"
  aria-hidden="true"
  tabindex="-1"
  data-open="false"
>
  <div class="drawer-header">
    <div class="drawer-header-left">
      <div class="drawer-title-row">
        <h2 class="drawer-title" id="report-drawer-heading">Resolution Report</h2>
        <span id="report-status-badge" class="report-status-badge status-valid">Valid</span>
      </div>
      <p class="drawer-subtitle">Live output from Kotlin Multiplatform docs-runtime</p>
    </div>

    <div class="drawer-header-actions">
      <button
        type="button"
        id="report-copy-json-btn"
        class="drawer-action-btn"
        aria-label="Copy report JSON"
        title="Copy complete resolution report JSON"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
        </svg>
        <span>Copy JSON</span>
      </button>

      <button
        type="button"
        id="report-close-btn"
        class="drawer-close-btn"
        aria-label="Close report drawer"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <div class="drawer-body">
    <!-- Theme Violations -->
    <section class="drawer-section" aria-labelledby="section-violations-title">
      <div class="section-title-row">
        <h3 id="section-violations-title" class="section-title">Theme Violations</h3>
        <span id="report-violations-count" class="violations-count">0</span>
      </div>
      <div id="report-violations-container" class="violations-list">
        <div class="violations-empty">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="empty-icon" aria-hidden="true">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
            <polyline points="22 4 12 14.01 9 11.01" />
          </svg>
          <p>No violations detected. Intent conforms to design system contracts.</p>
        </div>
      </div>
    </section>

    <!-- Pipeline Metadata & Contributions -->
    <section class="drawer-section" aria-labelledby="section-contributions-title">
      <h3 id="section-contributions-title" class="section-title">Resolution Metadata</h3>
      <div id="report-contributions-container" class="contributions-list">
        <div class="report-meta-card">
          <div class="meta-row">
            <span class="meta-label">Engine</span>
            <span class="meta-val">docs-runtime (JVM + JS)</span>
          </div>
          <div class="meta-row">
            <span class="meta-label">Resolved Modes</span>
            <span id="report-meta-modes" class="meta-val">Light, Dark</span>
          </div>
          <div class="meta-row">
            <span class="meta-label">Variable Prefix</span>
            <span class="meta-val">--b-* (preview scope)</span>
          </div>
          <div class="meta-row">
            <span class="meta-label">Active Preset</span>
            <span id="report-meta-preset" class="meta-val">Neutral</span>
          </div>
        </div>
      </div>
    </section>
  </div>
</aside>

<style>
  .drawer-backdrop {
    position: fixed;
    top: 56px;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(2px);
    z-index: 85;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .drawer-backdrop.is-active {
    opacity: 1;
    visibility: visible;
  }

  .studio-report-drawer {
    position: fixed;
    top: 56px;
    right: 0;
    bottom: 0;
    width: 400px;
    max-width: calc(100vw - 32px);
    background: var(--docs-surface);
    border-left: 1px solid var(--docs-border);
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.18);
    z-index: 90;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    visibility: hidden;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.25s;
  }

  .studio-report-drawer[data-open="true"] {
    transform: translateX(0);
    visibility: visible;
  }

  .drawer-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1.25rem 1.25rem 1rem 1.25rem;
    border-bottom: 1px solid var(--docs-border-subtle);
    background: var(--docs-surface);
  }

  .drawer-header-left {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .drawer-title-row {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .drawer-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--docs-text);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .report-status-badge {
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .report-status-badge.status-valid {
    background: rgba(34, 197, 94, 0.14);
    color: #22c55e;
    border: 1px solid rgba(34, 197, 94, 0.3);
  }

  .report-status-badge.status-violations {
    background: rgba(239, 68, 68, 0.14);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .drawer-subtitle {
    font-size: 0.75rem;
    color: var(--docs-text-muted);
    margin: 0;
  }

  .drawer-header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .drawer-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.35rem 0.65rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--docs-text);
    background: var(--docs-card-bg);
    border: 1px solid var(--docs-border);
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .drawer-action-btn:hover {
    background: var(--docs-card-hover);
    border-color: var(--docs-border-strong);
  }

  .drawer-action-btn:focus-visible {
    outline: 2px solid var(--docs-focus-ring);
    outline-offset: 2px;
  }

  .drawer-close-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    color: var(--docs-text-muted);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .drawer-close-btn:hover {
    color: var(--docs-text);
    background: var(--docs-card-hover);
  }

  .drawer-close-btn:focus-visible {
    outline: 2px solid var(--docs-focus-ring);
    outline-offset: 2px;
  }

  .drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .drawer-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .section-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .section-title {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--docs-text-muted);
    margin: 0;
  }

  .violations-count {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.1rem 0.45rem;
    border-radius: 9999px;
    background: var(--docs-card-bg);
    color: var(--docs-text);
    border: 1px solid var(--docs-border);
  }

  .violations-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .violations-empty {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1rem;
    background: var(--docs-card-bg);
    border: 1px solid var(--docs-border-subtle);
    border-radius: 8px;
    color: var(--docs-text-muted);
    font-size: 0.8125rem;
  }

  .violations-empty .empty-icon {
    color: #22c55e;
    flex-shrink: 0;
  }

  .violations-empty p {
    margin: 0;
    line-height: 1.4;
  }

  .report-meta-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.875rem 1rem;
    background: var(--docs-card-bg);
    border: 1px solid var(--docs-border-subtle);
    border-radius: 8px;
  }

  .meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8125rem;
  }

  .meta-label {
    color: var(--docs-text-muted);
  }

  .meta-val {
    color: var(--docs-text);
    font-weight: 600;
    font-family: monospace;
    font-size: 0.75rem;
  }

  @media (max-width: 900px) {
    .studio-report-drawer {
      width: 100vw;
      max-width: 100vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .studio-report-drawer {
      transition: none !important;
    }
    .drawer-backdrop {
      transition: none !important;
    }
  }
</style>
