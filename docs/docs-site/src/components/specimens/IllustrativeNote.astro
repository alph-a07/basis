---
/**
 * Illustrative rendering note component for Studio and Landing.
 * Informs the user that web specimens are illustrative previews driven by
 * the exact same Basis design tokens (--b-*) resolved by the Basis theme engine.
 * Styled strictly with Basis token variables (--b-*) in a subtle fine-print / disclaimer style.
 */
interface Props {
  title?: string;
  message?: string;
  class?: string;
}

const {
  title = 'Illustrative Web Rendering',
  message = 'Web specimens are illustrative HTML/CSS previews driven by Basis tokens (--b-*). Native Android applications render these tokens via Basis Jetpack Compose composables.',
  class: className = '',
} = Astro.props;
---

<div role="note" aria-label={title} class={`basis-specimen-illustrative-note ${className}`.trim()}>
  <span class="note-asterisk" aria-hidden="true">*</span>
  <p class="note-message">
    <span class="note-fineprint-prefix">{title}:</span>
    <slot>{message}</slot>
  </p>
</div>

<style>
  .basis-specimen-illustrative-note {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: var(--b-spacing-level1);
    padding: var(--b-spacing-level1) var(--b-spacing-level2);
    background: transparent;
    border: none;
    box-sizing: border-box;
    font-family: var(--b-typography-metadata-level2-family);
    opacity: 0.65;
    transition: opacity 0.2s ease;
  }

  .basis-specimen-illustrative-note:hover {
    opacity: 0.9;
  }

  .note-asterisk {
    font-size: var(--b-typography-metadata-level2-size);
    color: var(--b-color-content-muted);
    user-select: none;
    line-height: 1.4;
  }

  .note-message {
    font-size: var(--b-typography-metadata-level2-size);
    color: var(--b-color-content-muted);
    line-height: 1.4;
    margin: 0;
    text-align: center;
    letter-spacing: -0.01em;
  }

  .note-fineprint-prefix {
    font-weight: var(--b-typography-metadata-level1-weight);
    color: var(--b-color-content-muted);
    margin-right: 0.25rem;
  }
</style>
