---
/**
 * Chips specimen component for Studio and Landing illustrative previews.
 * Styled strictly with Basis token variables (--b-*).
 */
interface Props {
  label?: string;
  selected?: boolean;
  disabled?: boolean;
  state?: 'default' | 'hover' | 'focus' | 'selected' | 'disabled';
  class?: string;
}

const {
  label = 'Chip',
  selected = false,
  disabled = false,
  state = 'default',
  class: className = '',
} = Astro.props;

const isSelected = selected || state === 'selected';
const isDisabled = disabled || state === 'disabled';
---

<button
  type="button"
  role="checkbox"
  aria-checked={isSelected}
  disabled={isDisabled}
  aria-disabled={isDisabled}
  data-selected={isSelected ? 'true' : 'false'}
  data-state={state}
  class={`basis-specimen-chip ${className}`.trim()}
>
  <slot name="leading-icon" />
  <span class="chip-text"><slot>{label}</slot></span>
  <slot name="trailing-icon" />
</button>

<style>
  .basis-specimen-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--b-spacing-level2);
    height: var(--b-size-control-level2);
    padding: 0 var(--b-spacing-level3);
    border-radius: var(--b-radius-full);
    font-family: var(--b-typography-content-level2-family);
    font-size: var(--b-typography-content-level2-size);
    font-weight: var(--b-typography-content-level2-weight);
    line-height: 1;
    cursor: pointer;
    box-sizing: border-box;
    user-select: none;
    white-space: nowrap;
    transition: all var(--b-motion-stateTransition);
    background-color: var(--b-color-surface-elevated);
    color: var(--b-color-content-default);
    border: 1px solid var(--b-color-border-default);
  }

  .basis-specimen-chip:hover:not(:disabled),
  .basis-specimen-chip[data-state="hover"]:not(:disabled) {
    background-color: var(--b-color-surface-default);
    border-color: var(--b-color-border-strong);
  }

  .basis-specimen-chip:focus-visible,
  .basis-specimen-chip[data-state="focus"] {
    outline: 2px solid var(--b-color-focus-ring);
    outline-offset: var(--b-spacing-level1);
  }

  /* Selected state */
  .basis-specimen-chip[data-selected="true"] {
    background-color: var(--b-color-selection-surface);
    color: var(--b-color-selection-content);
    border-color: var(--b-color-selection-border);
  }

  .basis-specimen-chip[data-selected="true"]:hover:not(:disabled) {
    background-color: var(--b-color-selection-surface);
    border-color: var(--b-color-brand-primary);
  }

  /* Disabled state */
  .basis-specimen-chip:disabled,
  .basis-specimen-chip[data-state="disabled"] {
    background-color: var(--b-color-surface-recessed);
    color: var(--b-color-content-muted);
    border-color: var(--b-color-border-muted);
    cursor: not-allowed;
  }

  .chip-text {
    display: inline-block;
  }
</style>
