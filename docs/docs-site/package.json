{
  "name": "docs-site",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm run generate:theme && astro dev",
    "generate:theme": "tsx scripts/generate-theme.ts && tsx scripts/extract-snippets.ts",
    "prebuild": "npm run generate:theme",
    "build": "npm run generate:theme && astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "npm run generate:theme && astro check",
    "test:loader": "tsx scripts/test-loader-validation.ts",
    "test:theme": "tsx scripts/test-theme-resolution.ts",
    "test:templates": "tsx scripts/test-templates.ts",
    "test:a11y": "tsx scripts/test-a11y-layout.ts",
    "test:design": "tsx scripts/test-design-pass.ts",
    "test:links": "tsx scripts/test-link-checker.ts",
    "test": "tsx scripts/test-loader-validation.ts && npm run build && tsx scripts/test-theme-resolution.ts && tsx scripts/test-templates.ts && tsx scripts/test-a11y-layout.ts && tsx scripts/test-design-pass.ts && tsx scripts/test-link-checker.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.2",
    "astro": "^7.4.4",
    "mermaid": "^12.2.0",
    "pagefind": "^1.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@basis/docs-model": "*",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
