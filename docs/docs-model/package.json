{
  "name": "@basis/docs-model",
  "version": "0.2.0",
  "private": true,
  "description": "Basis documentation schemas, generated TypeScript definitions, validators, and sidecars",
  "main": "types/index.ts",
  "types": "types/index.ts",
  "exports": {
    ".": "./types/index.ts",
    "./validator": "./scripts/semantic-validator.ts"
  },
  "scripts": {
    "generate:types": "node ../../scripts/basis-npm-runner.mjs --label docs-model:generate:types -- tsx scripts/generate-types.ts",
    "prebuild": "node ../../scripts/basis-npm-runner.mjs --label docs-model:prebuild -- npm run generate:types",
    "validate": "tsx scripts/validate.ts",
    "validate:negative": "tsx scripts/validate-negative.ts",
    "check:provenance": "tsx scripts/check-provenance.ts",
    "test": "node ../../scripts/basis-npm-runner.mjs --label docs-model:test -- sh -c 'npm run validate && npm run validate:negative && npm run check:provenance'"
  },
  "devDependencies": {
    "@types/node": "22.13.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "json-schema-to-typescript": "15.0.4",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
